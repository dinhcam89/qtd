---
import DataTable from './ui/DataTable.astro';
import Notice from './ui/Notice.astro';
import type { RatesData } from '../lib/schemas/rates';
import { formatRate, formatText } from '../lib/format';
import { RATE_DISCLAIMER, DEFAULT_FALLBACK_TEXT } from '../lib/constants';

interface Props {
  rates: RatesData;
  /** Cấp heading của tiêu đề từng bảng (h3 trên trang chủ, h2 trên trang Lãi suất) */
  headingLevel?: 'h2' | 'h3';
}

const { rates, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel as any;
---

<div data-rates-tables class="space-y-6 sm:space-y-8">
  <!-- Dòng lưu ý lãi suất đặt lên đầu, ngay sau tiêu đề biểu lãi suất -->
  <Notice variant="warning">{RATE_DISCLAIMER}</Notice>

  <!-- Bảng 1: Lãi suất tiền gửi (một thẻ table duy nhất, CSS chuyển sang card trên mobile) -->
  <div class="space-y-3">
    <Heading class="text-xl font-semibold text-brand-primary">
      Lãi suất tiền gửi
    </Heading>
    {rates.deposit_rates.length > 0 ? (
      <DataTable caption="Lãi suất tiền gửi" class="shadow-xs md:table-fixed">
        <colgroup class="hidden md:table-column-group">
          <col class="w-[34%]" />
          <col class="w-[16%]" />
          <col class="w-[50%]" />
        </colgroup>
        <thead>
          <tr class="border-b border-border-default bg-surface-muted text-ink-base text-base font-semibold">
            <th scope="col" class="py-[0.875rem] px-4 text-left md:w-[34%]">
              Kỳ hạn
            </th>
            <th
              scope="col"
              class="py-[0.875rem] px-4 text-left md:text-right md:pl-4 md:pr-8 md:w-[16%]"
            >
              Lãi suất/năm
            </th>
            <th
              scope="col"
              class="py-[0.875rem] px-4 text-left md:pl-8 md:pr-4 md:w-[50%]"
            >
              Ghi chú
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default text-base">
          {rates.deposit_rates.map((item) => (
            <tr class="even:bg-surface-muted hover:bg-surface-muted/60 transition-colors">
              <td
                data-label="Kỳ hạn"
                class="py-[0.875rem] px-4 font-medium text-ink-base text-left break-words [overflow-wrap:anywhere]"
              >
                {formatText(item.term)}
              </td>
              <td
                data-label="Lãi suất/năm"
                class="py-[0.875rem] px-4 font-bold text-brand-primary text-left md:text-right md:pl-4 md:pr-8 tabular-nums break-words [overflow-wrap:anywhere]"
              >
                {formatRate(item.rate)}
              </td>
              <td
                data-label="Ghi chú"
                class="py-[0.875rem] px-4 text-ink-muted text-left md:pl-8 md:pr-4 break-words [overflow-wrap:anywhere]"
              >
                {formatText(item.note, '—')}
              </td>
            </tr>
          ))}
        </tbody>
      </DataTable>
    ) : (
      <p class="text-base text-ink-muted">{DEFAULT_FALLBACK_TEXT}</p>
    )}
  </div>

  <!-- Bảng 2: Lãi suất cho vay (một thẻ table duy nhất, CSS chuyển sang card trên mobile) -->
  <div class="space-y-3">
    <Heading class="text-xl font-semibold text-brand-primary">
      Lãi suất cho vay
    </Heading>
    {rates.loan_rates.length > 0 ? (
      <DataTable caption="Lãi suất cho vay" class="shadow-xs md:table-fixed">
        <colgroup class="hidden md:table-column-group">
          <col class="w-[34%]" />
          <col class="w-[16%]" />
          <col class="w-[18%]" />
          <col class="w-[32%]" />
        </colgroup>
        <thead>
          <tr class="border-b border-border-default bg-surface-muted text-ink-base text-base font-semibold">
            <th scope="col" class="py-[0.875rem] px-4 text-left md:w-[34%]">
              Mục đích vay
            </th>
            <th
              scope="col"
              class="py-[0.875rem] px-4 text-left md:text-right md:pl-4 md:pr-8 md:w-[16%]"
            >
              Lãi suất/năm
            </th>
            <th scope="col" class="py-[0.875rem] px-4 text-left md:w-[18%]">
              Kỳ hạn
            </th>
            <th
              scope="col"
              class="py-[0.875rem] px-4 text-left md:pl-8 md:pr-4 md:w-[32%]"
            >
              Ghi chú
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border-default text-base">
          {rates.loan_rates.map((item) => (
            <tr class="even:bg-surface-muted hover:bg-surface-muted/60 transition-colors">
              <td
                data-label="Mục đích vay"
                class="py-[0.875rem] px-4 font-medium text-ink-base text-left break-words [overflow-wrap:anywhere]"
              >
                {formatText(item.purpose)}
              </td>
              <td
                data-label="Lãi suất/năm"
                class="py-[0.875rem] px-4 font-bold text-brand-primary text-left md:text-right md:pl-4 md:pr-8 tabular-nums break-words [overflow-wrap:anywhere]"
              >
                {formatRate(item.rate)}
              </td>
              <td
                data-label="Kỳ hạn"
                class="py-[0.875rem] px-4 text-ink-muted text-left break-words [overflow-wrap:anywhere]"
              >
                {formatText(item.term, '—')}
              </td>
              <td
                data-label="Ghi chú"
                class="py-[0.875rem] px-4 text-ink-muted text-left md:pl-8 md:pr-4 break-words [overflow-wrap:anywhere]"
              >
                {formatText(item.note, '—')}
              </td>
            </tr>
          ))}
        </tbody>
      </DataTable>
    ) : (
      <p class="text-base text-ink-muted">{DEFAULT_FALLBACK_TEXT}</p>
    )}
  </div>
</div>
