---
import fs from 'node:fs';
import path from 'node:path';
import type { ContactData } from '../lib/schemas/contact';
import type { ScheduleData } from '../lib/schemas/schedule';
import type { SiteData } from '../lib/schemas/site';
import { formatText } from '../lib/format';
import { FOOTER_NAV_ITEMS } from '../lib/nav';
import { toTelHref, toMailtoHref, buildMapUrl } from '../lib/contact';
import Container from './ui/Container.astro';

interface Props {
  site: SiteData;
  contact: ContactData;
  schedule: ScheduleData;
}

const { site, contact, schedule } = Astro.props;

const publicRoot =
  process.env.QTD_FIXTURES === '1' ? 'src/fixtures/public' : 'public';

// Kiểm tra logo có tồn tại trong public/images/ hay không (ưu tiên logo truyền thống)
const hasClassicLogo = fs.existsSync(
  path.resolve(process.cwd(), `${publicRoot}/images/logo-qtdnd-classic.png`)
);
const hasLogoPng = fs.existsSync(
  path.resolve(process.cwd(), `${publicRoot}/images/logo.png`)
);
const hasLogoSvg = fs.existsSync(
  path.resolve(process.cwd(), `${publicRoot}/images/logo.svg`)
);
const hasLogoWebp = fs.existsSync(
  path.resolve(process.cwd(), `${publicRoot}/images/logo.webp`)
);
const hasBhtgCert = fs.existsSync(
  path.resolve(process.cwd(), `${publicRoot}/images/chung-nhan-bhtg-vn.png`)
);
const logoSrc = hasClassicLogo
  ? '/images/logo-qtdnd-classic.png'
  : hasLogoSvg
    ? '/images/logo.svg'
    : hasLogoWebp
      ? '/images/logo.webp'
      : hasLogoPng
        ? '/images/logo.png'
        : null;

const phoneHref = toTelHref(contact.phone);
const hotlineHref = toTelHref(contact.hotline);
const emailHref = toMailtoHref(contact.email);
const mapUrl = contact.map_embed_url || buildMapUrl(contact.address?.full);

const currentYear = new Date().getFullYear();
---

<footer
  id="lien-he"
  class="border-t border-border-default bg-surface-muted text-ink-base mt-auto"
>
  <Container class="py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.3fr_1.4fr_0.9fr] gap-8 lg:gap-12 items-stretch">
      <!-- Cột 1: Thông tin Quỹ -->
      <div class="flex flex-col justify-between gap-4">
        <div class="space-y-3">
          <div data-site-footer-brand class="flex items-center gap-3">
            {logoSrc && (
              <img
                src={logoSrc}
                alt={`Logo ${formatText(site.name)}`}
                width="48"
                height="48"
                class="h-11 sm:h-12 w-auto object-contain shrink-0"
                loading="lazy"
              />
            )}
            <h2 class="text-base sm:text-lg font-bold text-brand-primary leading-snug">
              {site.name.toUpperCase().startsWith('QUỸ TÍN DỤNG NHÂN DÂN') ? (
                <>
                  <span class="block">QUỸ TÍN DỤNG NHÂN DÂN</span>
                  <span class="block text-lg sm:text-xl font-extrabold text-brand-primary mt-0.5">
                    {site.name.replace(/^QUỸ TÍN DỤNG NHÂN DÂN\s*/i, '')}
                  </span>
                </>
              ) : (
                formatText(site.name)
              )}
            </h2>
          </div>
          {site.short_name && (
            <p class="text-sm text-ink-muted">
              <span class="font-medium text-ink-base">Tên viết tắt:</span>{' '}
              {formatText(site.short_name)}
            </p>
          )}
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Giấy phép hoạt động:</span>{' '}
            {formatText(site.license_number)}
          </p>
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Địa bàn hoạt động:</span>{' '}
            {site.operating_area &&
            site.operating_area.includes('Quảng Trị') ? (
              <>
                {site.operating_area.replace(/,?\s*Tỉnh Quảng Trị$/, '')},{' '}
                <span class="whitespace-nowrap">Tỉnh Quảng Trị</span>
              </>
            ) : (
              formatText(site.operating_area)
            )}
          </p>
        </div>
        {hasBhtgCert && (
          <div class="pt-2">
            <a
              href="https://div.gov.vn"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border-focus rounded"
              title="Bảo hiểm tiền gửi Việt Nam (DIV) - Mở trang web chính thức trong tab mới"
              aria-label="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam (mở trang web chính thức div.gov.vn trong tab mới)"
            >
              <img
                src="/images/chung-nhan-bhtg-vn.png"
                alt="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam"
                width="218"
                height="150"
                class="h-20 sm:h-24 w-auto object-contain block"
                loading="lazy"
              />
            </a>
          </div>
        )}
      </div>

      <!-- Cột 2: Thông tin liên hệ + Google Mini-Map ngang hàng chứng nhận BHTG -->
      <div class="flex flex-col justify-between gap-4">
        <div class="space-y-3">
          <h2 class="text-lg font-bold text-brand-primary">
            Thông tin liên hệ
          </h2>
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Địa chỉ:</span>{' '}
            {contact.address.full &&
            contact.address.full.includes('Quảng Trị') ? (
              <>
                {contact.address.full.replace(/,?\s*Tỉnh Quảng Trị$/, '')},{' '}
                <span class="whitespace-nowrap">Tỉnh Quảng Trị</span>
              </>
            ) : (
              formatText(contact.address.full)
            )}
          </p>
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Điện thoại:</span>{' '}
            {phoneHref ? (
              <a
                href={phoneHref}
                class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
              >
                {contact.phone}
              </a>
            ) : (
              formatText(contact.phone)
            )}
          </p>
          {contact.hotline && (
            <p class="text-sm text-ink-muted">
              <span class="font-medium text-ink-base">Đường dây nóng:</span>{' '}
              {hotlineHref ? (
                <a
                  href={hotlineHref}
                  class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
                >
                  {contact.hotline}
                </a>
              ) : (
                formatText(contact.hotline)
              )}
            </p>
          )}
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Email:</span>{' '}
            {emailHref ? (
              <a
                href={emailHref}
                class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
              >
                {contact.email}
              </a>
            ) : (
              formatText(contact.email)
            )}
          </p>
        </div>
        {mapUrl && (
          <div class="pt-2">
            <a
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              title="Mở vị trí Hội sở Quỹ trên Google Maps trong tab mới"
              class="group relative block h-20 sm:h-24 w-full max-w-[330px] rounded-xl border border-border-strong bg-[#e8eaed] overflow-hidden shadow-xs hover:border-brand-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border-focus transition-colors"
            >
              <!-- Bản đồ vector phong cách Google Maps (nội bộ, tuân thủ CSP & bảo mật) -->
              <svg
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                viewBox="0 0 330 96"
                preserveAspectRatio="xMidYMid slice"
                aria-hidden="true"
              >
                <rect width="330" height="96" fill="#e8eaed" />
                <!-- Mảng công viên xanh & sông nước Google Maps -->
                <path d="M0 0 H95 L72 96 H0 Z" fill="#ceead6" />
                <path d="M235 0 H330 V58 L260 96 Z" fill="#ceead6" />
                <path
                  d="M-10 74 Q85 52 175 68 T340 42 L340 58 Q255 82 170 80 T-10 90 Z"
                  fill="#a0c3ff"
                />
                <!-- Lưới đường giao thông phụ -->
                <g stroke="#ffffff" stroke-width="4" fill="none">
                  <path d="M48 -5 L88 102" />
                  <path d="M142 -5 L124 102" />
                  <path d="M218 -5 L245 102" />
                  <path d="M-5 26 L335 18" />
                </g>
                <!-- Trục đường chính (vàng Google Maps) -->
                <path
                  d="M-5 50 Q140 36 335 62"
                  stroke="#fbbc04"
                  stroke-width="7"
                  fill="none"
                />
                <path
                  d="M-5 50 Q140 36 335 62"
                  stroke="#fde293"
                  stroke-width="4.5"
                  fill="none"
                />
                <!-- Vòng tròn định vị & Ghim đỏ Google Maps tại vị trí Hội sở -->
                <circle
                  cx="168"
                  cy="46"
                  r="15"
                  fill="#ea4335"
                  fill-opacity="0.18"
                />
                <ellipse
                  cx="168"
                  cy="55"
                  rx="5"
                  ry="2"
                  fill="#000000"
                  fill-opacity="0.25"
                />
                <path
                  d="M168 18 C159.7 18 153 24.7 153 33 C153 44.2 168 55 168 55 C168 55 183 44.2 183 33 C183 24.7 176.3 18 168 18 Z"
                  fill="#ea4335"
                  stroke="#ffffff"
                  stroke-width="2"
                />
                <circle cx="168" cy="33" r="5.5" fill="#b31412" />
              </svg>

              <!-- Nhãn địa điểm nổi góc trái trên -->
              <span class="relative z-10 inline-flex items-center gap-1.5 m-2 px-2.5 py-1 rounded-md bg-white border border-border-default shadow-xs text-[11px] font-bold text-ink-base max-w-[220px] truncate">
                <span
                  class="w-2 h-2 rounded-full bg-[#ea4335] shrink-0"
                  aria-hidden="true"
                />
                <span class="truncate">Hội sở {formatText(site.name)}</span>
              </span>

              <!-- Nút chỉ đường Google Maps nổi góc phải dưới -->
              <span class="absolute bottom-2 right-2 z-10 inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-brand-dark text-white text-[11px] font-semibold shadow-xs group-hover:bg-brand-primary transition-colors">
                <span>Google Maps</span>
                <span aria-hidden="true">&nearr;</span>
              </span>
            </a>
          </div>
        )}
      </div>

      <!-- Cột 3: Thời gian làm việc -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thời gian làm việc</h2>
        <div>
          <span class="text-sm font-medium text-ink-base">Ngày làm việc:</span>
          <p class="text-sm font-semibold text-ink-base whitespace-pre-line mt-0.5">
            {formatText(schedule.working_days)}
          </p>
        </div>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Buổi sáng:</span>{' '}
          {formatText(schedule.morning_hours)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Buổi chiều:</span>{' '}
          {formatText(schedule.afternoon_hours)}
        </p>
        {schedule.notes && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Lưu ý:</span>{' '}
            {formatText(schedule.notes)}
          </p>
        )}
      </div>
    </div>

    <!-- Liên kết nhanh: danh sách liên kết nhanh ở footer (đã bỏ Quy mô và Ban lãnh đạo) -->
    <nav
      data-footer-nav
      aria-label="Liên kết nhanh"
      class="border-t border-border-default mt-10 pt-6"
    >
      <h2 class="text-lg font-bold text-brand-primary mb-3">Liên kết nhanh</h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {FOOTER_NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex items-center min-h-[44px] text-base text-ink-base hover:text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Dòng bản quyền -->
    <div class="border-t border-border-default mt-10 pt-6 text-center text-sm text-ink-muted">
      <p id="footer-copyright">
        {`© ${currentYear} Bản quyền thuộc về ${formatText(site.name)}`}
      </p>
    </div>
  </Container>
</footer>
