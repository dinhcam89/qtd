---
import type { ContactData } from '../lib/schemas/contact';
import type { ScheduleData } from '../lib/schemas/schedule';
import type { SiteData } from '../lib/schemas/site';
import { formatText } from '../lib/format';
import { RATE_DISCLAIMER } from '../lib/constants';

interface Props {
  site: SiteData;
  contact: ContactData;
  schedule: ScheduleData;
}

const { site, contact, schedule } = Astro.props;

/**
 * Kiểm tra xem một giá trị liên hệ có hợp lệ để gắn thẻ link tel: hoặc mailto: hay không.
 * Nếu là null hoặc placeholder [CẦN BỔ SUNG...] thì không gắn link.
 */
function isActionableContact(val: string | null | undefined): boolean {
  if (!val) return false;
  const trimmed = val.trim();
  if (trimmed.startsWith('[') && trimmed.includes('CẦN BỔ SUNG')) {
    return false;
  }
  return trimmed.length > 0;
}

const currentYear = new Date().getFullYear();
---

<footer
  id="lien-he"
  class="border-t border-brand-border bg-brand-surface text-brand-text mt-auto"
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-10 lg:py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <!-- Cột 1: Thông tin Quỹ -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">
          {formatText(site.name)}
        </h2>
        {site.short_name && (
          <p class="text-sm text-brand-muted">
            Tên viết tắt: {formatText(site.short_name)}
          </p>
        )}
        <p class="text-sm text-brand-muted">
          Giấy phép hoạt động: {formatText(site.license_number)}
        </p>
        <p class="text-sm text-brand-muted">
          Địa bàn hoạt động: {formatText(site.operating_area)}
        </p>
      </div>

      <!-- Cột 2: Thông tin liên hệ -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thông tin liên hệ</h2>
        <p class="text-sm text-brand-muted">
          <span class="font-medium text-brand-text">Địa chỉ:</span>{' '}
          {formatText(contact.address.full)}
        </p>
        <p class="text-sm text-brand-muted">
          <span class="font-medium text-brand-text">Điện thoại:</span>{' '}
          {isActionableContact(contact.phone) ? (
            <a
              href={`tel:${contact.phone}`}
              class="text-brand-primary hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-focus"
            >
              {contact.phone}
            </a>
          ) : (
            formatText(contact.phone)
          )}
        </p>
        {contact.hotline && (
          <p class="text-sm text-brand-muted">
            <span class="font-medium text-brand-text">Đường dây nóng:</span>{' '}
            {isActionableContact(contact.hotline) ? (
              <a
                href={`tel:${contact.hotline}`}
                class="text-brand-primary hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-focus"
              >
                {contact.hotline}
              </a>
            ) : (
              formatText(contact.hotline)
            )}
          </p>
        )}
        <p class="text-sm text-brand-muted">
          <span class="font-medium text-brand-text">Email:</span>{' '}
          {isActionableContact(contact.email) ? (
            <a
              href={`mailto:${contact.email}`}
              class="text-brand-primary hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-brand-focus"
            >
              {contact.email}
            </a>
          ) : (
            formatText(contact.email)
          )}
        </p>
      </div>

      <!-- Cột 3: Thời gian làm việc -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thời gian làm việc</h2>
        <p class="text-sm text-brand-muted">
          <span class="font-medium text-brand-text">Ngày làm việc:</span>{' '}
          {formatText(schedule.working_days)}
        </p>
        <p class="text-sm text-brand-muted">
          <span class="font-medium text-brand-text">Buổi sáng:</span>{' '}
          {formatText(schedule.morning_hours)}
        </p>
        <p class="text-sm text-brand-muted">
          <span class="font-medium text-brand-text">Buổi chiều:</span>{' '}
          {formatText(schedule.afternoon_hours)}
        </p>
        {schedule.notes && (
          <p class="text-xs text-brand-muted italic">
            Lưu ý: {formatText(schedule.notes)}
          </p>
        )}
      </div>
    </div>

    <!-- Dòng bản quyền và lưu ý -->
    <div class="border-t border-brand-border mt-8 pt-6 text-center text-xs text-brand-muted space-y-2">
      <p>
        &copy; {currentYear} {formatText(site.name)}. Tất cả các quyền được bảo
        lưu.
      </p>
      <p class="italic">{RATE_DISCLAIMER}</p>
    </div>
  </div>
</footer>
