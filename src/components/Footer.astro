---
import fs from 'node:fs';
import path from 'node:path';
import type { ContactData } from '../lib/schemas/contact';
import type { ScheduleData } from '../lib/schemas/schedule';
import type { SiteData } from '../lib/schemas/site';
import { formatText } from '../lib/format';
import { FOOTER_NAV_ITEMS } from '../lib/nav';
import { toTelHref, toMailtoHref } from '../lib/contact';
import Container from './ui/Container.astro';

interface Props {
  site: SiteData;
  contact: ContactData;
  schedule: ScheduleData;
}

const { site, contact, schedule } = Astro.props;

// Kiểm tra logo có tồn tại trong public/images/ hay không
const hasLogoPng = fs.existsSync(
  path.resolve(process.cwd(), 'public/images/logo.png')
);
const hasLogoSvg = fs.existsSync(
  path.resolve(process.cwd(), 'public/images/logo.svg')
);
const hasLogoWebp = fs.existsSync(
  path.resolve(process.cwd(), 'public/images/logo.webp')
);
const logoSrc = hasLogoSvg
  ? '/images/logo.svg'
  : hasLogoWebp
    ? '/images/logo.webp'
    : hasLogoPng
      ? '/images/logo.png'
      : null;

const phoneHref = toTelHref(contact.phone);
const hotlineHref = toTelHref(contact.hotline);
const emailHref = toMailtoHref(contact.email);

const currentYear = new Date().getFullYear();
---

<footer
  id="lien-he"
  class="border-t border-border-default bg-surface-muted text-ink-base mt-auto"
>
  <Container class="py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1.3fr_1.4fr_0.9fr] gap-8 lg:gap-12">
      <!-- Cột 1: Thông tin Quỹ -->
      <div class="space-y-3">
        <div class="flex items-center gap-3">
          {logoSrc && (
            <img
              src={logoSrc}
              alt={`Logo ${formatText(site.name)}`}
              width="48"
              height="48"
              class="h-11 sm:h-12 w-auto object-contain shrink-0"
              loading="lazy"
            />
          )}
          <h2
            data-site-footer-brand
            class="text-base sm:text-lg font-bold text-brand-primary leading-snug"
          >
            {site.name.toUpperCase().startsWith('QUỸ TÍN DỤNG NHÂN DÂN') ? (
              <>
                <span class="block">QUỸ TÍN DỤNG NHÂN DÂN</span>
                <span class="block text-lg sm:text-xl font-extrabold text-brand-primary mt-0.5">
                  {site.name.replace(/^QUỸ TÍN DỤNG NHÂN DÂN\s*/i, '')}
                </span>
              </>
            ) : (
              formatText(site.name)
            )}
          </h2>
        </div>
        {site.short_name && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Tên viết tắt:</span>{' '}
            {formatText(site.short_name)}
          </p>
        )}
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Giấy phép hoạt động:</span>{' '}
          {formatText(site.license_number)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Địa bàn hoạt động:</span>{' '}
          {site.operating_area && site.operating_area.includes('Quảng Trị') ? (
            <>
              {site.operating_area.replace(/,?\s*Tỉnh Quảng Trị$/, '')},{' '}
              <span class="whitespace-nowrap">Tỉnh Quảng Trị</span>
            </>
          ) : (
            formatText(site.operating_area)
          )}
        </p>
        <div class="pt-2">
          <a
            href="https://div.gov.vn"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-xl border border-border-default bg-surface-page p-2 shadow-xs hover:border-brand-primary/40 hover:shadow-sm transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
            title="Bảo hiểm tiền gửi Việt Nam (DIV) - Mở trang web chính thức trong tab mới"
            aria-label="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam (mở trang web chính thức div.gov.vn trong tab mới)"
          >
            <img
              src="/images/bhtg-chung-nhan.png"
              alt="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam"
              width="140"
              height="85"
              class="h-14 sm:h-16 w-auto object-contain block"
              loading="lazy"
            />
          </a>
        </div>
      </div>

      <!-- Cột 2: Thông tin liên hệ -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thông tin liên hệ</h2>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Địa chỉ:</span>{' '}
          {contact.address.full &&
          contact.address.full.includes('Quảng Trị') ? (
            <>
              {contact.address.full.replace(/,?\s*Tỉnh Quảng Trị$/, '')},{' '}
              <span class="whitespace-nowrap">Tỉnh Quảng Trị</span>
            </>
          ) : (
            formatText(contact.address.full)
          )}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Điện thoại:</span>{' '}
          {phoneHref ? (
            <a
              href={phoneHref}
              class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
            >
              {contact.phone}
            </a>
          ) : (
            formatText(contact.phone)
          )}
        </p>
        {contact.hotline && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Đường dây nóng:</span>{' '}
            {hotlineHref ? (
              <a
                href={hotlineHref}
                class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
              >
                {contact.hotline}
              </a>
            ) : (
              formatText(contact.hotline)
            )}
          </p>
        )}
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Email:</span>{' '}
          {emailHref ? (
            <a
              href={emailHref}
              class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
            >
              {contact.email}
            </a>
          ) : (
            formatText(contact.email)
          )}
        </p>
      </div>

      <!-- Cột 3: Thời gian làm việc -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thời gian làm việc</h2>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Ngày làm việc:</span>{' '}
          {formatText(schedule.working_days)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Buổi sáng:</span>{' '}
          {formatText(schedule.morning_hours)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Buổi chiều:</span>{' '}
          {formatText(schedule.afternoon_hours)}
        </p>
        {schedule.notes && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Lưu ý:</span>{' '}
            {formatText(schedule.notes)}
          </p>
        )}
      </div>
    </div>

    <!-- Liên kết nhanh: danh sách liên kết nhanh ở footer (đã bỏ Quy mô và Ban lãnh đạo) -->
    <nav
      data-footer-nav
      aria-label="Liên kết nhanh"
      class="border-t border-border-default mt-10 pt-6"
    >
      <h2 class="text-lg font-bold text-brand-primary mb-3">Liên kết nhanh</h2>
      <ul class="flex flex-wrap gap-x-6 gap-y-1">
        {FOOTER_NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex items-center min-h-[44px] text-base text-ink-base hover:text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Dòng bản quyền -->
    <div class="border-t border-border-default mt-10 pt-6 text-center text-sm text-ink-muted">
      <p id="footer-copyright">
        {`© ${currentYear} Bản quyền thuộc về ${formatText(site.name)}`}
      </p>
    </div>
  </Container>
</footer>
