---
import type { ContactData } from '../lib/schemas/contact';
import type { ScheduleData } from '../lib/schemas/schedule';
import type { SiteData } from '../lib/schemas/site';
import { formatText } from '../lib/format';
import { RATE_DISCLAIMER } from '../lib/constants';
import Container from './ui/Container.astro';

interface Props {
  site: SiteData;
  contact: ContactData;
  schedule: ScheduleData;
}

const { site, contact, schedule } = Astro.props;

/**
 * Kiểm tra xem một giá trị liên hệ có hợp lệ để gắn thẻ link tel: hoặc mailto: hay không.
 * Nếu là null hoặc chưa có thông tin thực tế (dạng [placeholder]) thì không gắn link.
 */
function isActionableContact(val: string | null | undefined): boolean {
  if (!val) return false;
  const trimmed = val.trim();
  if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
    return false;
  }
  return trimmed.length > 0;
}

const currentYear = new Date().getFullYear();
---

<footer
  id="lien-he"
  class="border-t border-border-default bg-surface-muted text-ink-base mt-auto"
>
  <Container class="py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
      <!-- Cột 1: Thông tin Quỹ -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">
          {formatText(site.name)}
        </h2>
        {site.short_name && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Tên viết tắt:</span>{' '}
            {formatText(site.short_name)}
          </p>
        )}
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Giấy phép hoạt động:</span>{' '}
          {formatText(site.license_number)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Địa bàn hoạt động:</span>{' '}
          {formatText(site.operating_area)}
        </p>
      </div>

      <!-- Cột 2: Thông tin liên hệ -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thông tin liên hệ</h2>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Địa chỉ:</span>{' '}
          {formatText(contact.address.full)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Điện thoại:</span>{' '}
          {isActionableContact(contact.phone) ? (
            <a
              href={`tel:${contact.phone}`}
              class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
            >
              {contact.phone}
            </a>
          ) : (
            formatText(contact.phone)
          )}
        </p>
        {contact.hotline && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Đường dây nóng:</span>{' '}
            {isActionableContact(contact.hotline) ? (
              <a
                href={`tel:${contact.hotline}`}
                class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
              >
                {contact.hotline}
              </a>
            ) : (
              formatText(contact.hotline)
            )}
          </p>
        )}
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Email:</span>{' '}
          {isActionableContact(contact.email) ? (
            <a
              href={`mailto:${contact.email}`}
              class="text-brand-primary font-medium hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
            >
              {contact.email}
            </a>
          ) : (
            formatText(contact.email)
          )}
        </p>
      </div>

      <!-- Cột 3: Thời gian làm việc -->
      <div class="space-y-3">
        <h2 class="text-lg font-bold text-brand-primary">Thời gian làm việc</h2>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Ngày làm việc:</span>{' '}
          {formatText(schedule.working_days)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Buổi sáng:</span>{' '}
          {formatText(schedule.morning_hours)}
        </p>
        <p class="text-sm text-ink-muted">
          <span class="font-medium text-ink-base">Buổi chiều:</span>{' '}
          {formatText(schedule.afternoon_hours)}
        </p>
        {schedule.notes && (
          <p class="text-sm text-ink-muted">
            <span class="font-medium text-ink-base">Lưu ý:</span>{' '}
            {formatText(schedule.notes)}
          </p>
        )}
      </div>
    </div>

    <!-- Dòng bản quyền và lưu ý -->
    <div class="border-t border-border-default mt-10 pt-6 text-center text-sm text-ink-muted space-y-2">
      <p id="footer-copyright">
        {`© ${currentYear} ${formatText(site.name)}. Tất cả các quyền được bảo lưu.`}
      </p>
      <p class="not-italic text-sm text-ink-muted">{RATE_DISCLAIMER}</p>
    </div>
  </Container>
</footer>
