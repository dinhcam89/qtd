---
import fs from 'node:fs';
import path from 'node:path';
import { NAV_ITEMS, PRIMARY_NAV_ITEMS } from '../lib/nav';
import Container from './ui/Container.astro';

interface Props {
  siteName?: string;
}

const { siteName = '' } = Astro.props;

// Kiểm tra logo có tồn tại trong public/images/ hay không
const hasLogoPng = fs.existsSync(
  path.resolve(process.cwd(), 'public/images/logo.png')
);
const hasLogoSvg = fs.existsSync(
  path.resolve(process.cwd(), 'public/images/logo.svg')
);
const hasLogoWebp = fs.existsSync(
  path.resolve(process.cwd(), 'public/images/logo.webp')
);
const logoSrc = hasLogoSvg
  ? '/images/logo.svg'
  : hasLogoWebp
    ? '/images/logo.webp'
    : hasLogoPng
      ? '/images/logo.png'
      : null;
---

<header
  class="border-b border-border-default bg-surface-page sticky top-0 z-40"
  id="site-header"
>
  <Container class="px-3 sm:px-4 lg:px-6">
    <div class="flex items-center justify-between min-h-[5rem] py-2 sm:py-2.5">
      <!-- Logo và Tên Quỹ -->
      <a
        href="/"
        data-header-brand
        data-site-brand
        class="inline-flex items-center gap-2.5 sm:gap-3 text-lg sm:text-xl lg:text-2xl font-bold tracking-tight text-brand-primary hover:text-brand-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded py-1 transition-colors mr-auto shrink-0"
      >
        {logoSrc && (
          <img
            src={logoSrc}
            alt={`Logo ${siteName}`}
            width="64"
            height="64"
            class="h-14 sm:h-16 w-auto object-contain shrink-0"
          />
        )}
        {siteName.toUpperCase().includes('QUỸ TÍN DỤNG NHÂN DÂN') ? (
          <span class="flex flex-col text-left leading-none py-0.5">
            <span class="text-xs sm:text-xs lg:text-sm font-bold text-ink-base uppercase tracking-wider">
              QUỸ TÍN DỤNG NHÂN DÂN
            </span>
            <span class="text-lg sm:text-xl lg:text-2xl font-extrabold text-brand-primary tracking-tight mt-0.5">
              {siteName.replace(/^QUỸ TÍN DỤNG NHÂN DÂN\s*/i, '')}
            </span>
          </span>
        ) : (
          <span>{siteName}</span>
        )}
      </a>

      <!-- Menu ngang trên Desktop (lg+): chỉ các mục primary, các trang con nằm ở Giới thiệu/footer -->
      <nav
        data-desktop-nav
        class="hidden lg:flex items-center space-x-1 xl:space-x-1.5 ml-4 xl:ml-8 shrink-0"
        aria-label="Điều hướng chính"
      >
        {PRIMARY_NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="px-2.5 xl:px-3.5 py-2 min-h-[44px] inline-flex items-center text-sm xl:text-base font-medium text-ink-base hover:text-brand-primary hover:bg-surface-muted rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Bộ chọn ngôn ngữ Tiếng Việt / Tiếng Anh (Góc trên bên phải) -->
      <div class="hidden lg:flex items-center ml-2 xl:ml-3 pl-2 xl:pl-3 border-l border-border-default shrink-0">
        <div
          class="inline-flex items-center p-0.5 rounded-lg bg-surface-muted border border-border-default text-xs font-semibold"
          role="group"
          aria-label="Lựa chọn ngôn ngữ"
        >
          <span
            class="px-2 py-1 rounded-md bg-brand-primary text-white shadow-xs cursor-default select-none"
            aria-current="true"
          >
            VI
          </span>
          <button
            type="button"
            id="lang-en-btn"
            class="px-2 py-1 rounded-md text-ink-muted hover:text-ink-base transition-colors focus-visible:outline-2 focus-visible:outline-border-focus"
            title="English (Phiên bản tiếng Anh đang được chuẩn bị)"
            aria-label="Chuyển sang tiếng Anh"
          >
            EN
          </button>
        </div>
      </div>

      <!-- Nút Hamburger trên Mobile (vùng bấm tối thiểu 44x44px) -->
      <button
        type="button"
        id="menu-toggle-btn"
        class="inline-flex lg:hidden items-center gap-1.5 px-3 py-2 min-w-[44px] min-h-[44px] rounded-md text-ink-base hover:bg-surface-muted font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Menu"
      >
        <span class="text-sm font-semibold">Menu</span>
        <svg
          class="w-6 h-6 icon-open"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          class="w-6 h-6 icon-close hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Panel Menu Mobile -->
    <nav
      id="mobile-nav-panel"
      class="hidden lg:hidden border-t border-border-default py-3"
      aria-label="Điều hướng trên di động"
    >
      <ul class="flex flex-col space-y-1">
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="block px-4 py-3 min-h-[44px] text-base font-medium text-ink-base hover:text-brand-primary hover:bg-surface-muted rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="pt-2 border-t border-border-default px-4 py-2">
          <div class="flex items-center justify-between text-sm font-medium text-ink-muted">
            <span>Ngôn ngữ / Language:</span>
            <div
              class="inline-flex items-center p-0.5 rounded-lg bg-surface-muted border border-border-default text-xs font-semibold"
              role="group"
              aria-label="Lựa chọn ngôn ngữ"
            >
              <span class="px-2.5 py-1 rounded-md bg-brand-primary text-white shadow-xs">
                VI
              </span>
              <button
                type="button"
                id="lang-en-btn-mobile"
                class="px-2.5 py-1 rounded-md text-ink-muted hover:text-ink-base"
                title="English (Phiên bản tiếng Anh đang được chuẩn bị)"
                aria-label="Chuyển sang tiếng Anh"
              >
                EN
              </button>
            </div>
          </div>
        </li>
      </ul>
    </nav>
  </Container>
</header>

<script src="../scripts/menu.ts"></script>
