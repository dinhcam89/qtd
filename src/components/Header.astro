---
import { NAV_ITEMS } from '../lib/nav';
import Container from './ui/Container.astro';

interface Props {
  siteName?: string;
}

const { siteName = '' } = Astro.props;
---

<header
  class="border-b border-border-default bg-surface-page sticky top-0 z-40"
  id="site-header"
>
  <Container>
    <div class="flex items-center justify-between min-h-[4.5rem] py-3">
      <!-- Tên Quỹ dạng chữ, không vẽ logo/khẩu hiệu giả -->
      <a
        href="/"
        class="text-xl sm:text-2xl font-bold tracking-tight text-brand-primary hover:text-brand-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded py-1 transition-colors"
      >
        {siteName}
      </a>

      <!-- Menu ngang trên Desktop (lg+) -->
      <nav
        class="hidden lg:flex items-center space-x-1"
        aria-label="Điều hướng chính"
      >
        {NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class="px-4 py-2 min-h-[44px] inline-flex items-center text-base font-medium text-ink-base hover:text-brand-primary hover:bg-surface-muted rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Nút Hamburger trên Mobile (vùng bấm tối thiểu 44x44px, ẩn khi chưa nạp JS) -->
      <button
        type="button"
        id="menu-toggle-btn"
        class="hidden lg:hidden inline-flex items-center gap-1.5 px-3 py-2 min-w-[44px] min-h-[44px] rounded-md text-ink-base hover:bg-surface-muted font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Menu"
      >
        <span class="text-sm font-semibold">Menu</span>
        <svg
          class="w-6 h-6 icon-open"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          class="w-6 h-6 icon-close hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Panel Menu Mobile -->
    <nav
      id="mobile-nav-panel"
      class="lg:hidden border-t border-border-default py-3"
      aria-label="Điều hướng trên di động"
    >
      <ul class="flex flex-col space-y-1">
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class="block px-4 py-3 min-h-[44px] text-base font-medium text-ink-base hover:text-brand-primary hover:bg-surface-muted rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</header>

<script src="../scripts/menu.ts"></script>
