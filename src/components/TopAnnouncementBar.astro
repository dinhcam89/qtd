---
import Container from './ui/Container.astro';
import { getPublishedNews, getNewsDetailHref } from '../lib/news';

const publishedNews = await getPublishedNews();
const latestNotice =
  publishedNews.find((item) => item.data.category === 'thong-bao') ||
  publishedNews[0];

if (!latestNotice) {
  return null;
}
---

<div
  id="top-announcement-bar"
  data-notice-id={latestNotice.id}
  class="relative bg-amber-500/15 border-b border-amber-500/25 text-amber-950 transition-all z-50 text-xs sm:text-sm font-medium"
  role="region"
  aria-label="Thông báo mới"
>
  <Container class="px-3 sm:px-4 lg:px-6 py-2 sm:py-2.5">
    <div class="flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 sm:gap-2.5 min-w-0 flex-1">
        <!-- Icon loa phát thanh -->
        <span
          class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-500/20 text-amber-800 shrink-0"
          aria-hidden="true"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
            ></path>
          </svg>
        </span>

        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-amber-600 text-white shrink-0">
          Thông báo
        </span>

        <!-- Tiêu đề thông báo và liên kết -->
        <div class="truncate flex items-center gap-1.5">
          <span class="truncate font-semibold text-ink-base">
            {latestNotice.data.title}
          </span>
          <a
            href={getNewsDetailHref(latestNotice.id)}
            class="shrink-0 text-brand-primary font-bold hover:underline inline-flex items-center gap-0.5 ml-1 focus-visible:outline-2 focus-visible:outline-border-focus rounded"
          >
            <span>Chi tiết</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Nút đóng thông báo -->
      <button
        type="button"
        id="close-announcement-btn"
        class="inline-flex items-center justify-center w-7 h-7 -mr-1 rounded-md text-ink-muted hover:text-ink-base hover:bg-amber-500/20 transition-colors focus-visible:outline-2 focus-visible:outline-border-focus shrink-0"
        aria-label="Đóng thông báo"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </Container>
</div>

<script src="../scripts/announcement.ts"></script>
