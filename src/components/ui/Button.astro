---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary';
  class?: string;
  id?: string;
  target?: string;
  rel?: string;
  'aria-label'?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  class: className = '',
  id,
  target,
  rel,
  'aria-label': ariaLabel,
  ...rest
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-6 py-2.5 rounded-md text-base font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus text-center select-none';

const variantStyles = {
  primary:
    'bg-brand-primary text-ink-inverse hover:bg-brand-primary-hover border border-transparent shadow-xs',
  secondary:
    'bg-surface-page text-brand-primary border-2 border-brand-primary hover:bg-surface-brand-subtle',
};

const combinedClass = [baseStyles, variantStyles[variant], className].join(' ');
---

{href ? (
  <a
    href={href}
    class={combinedClass}
    id={id}
    target={target}
    rel={target === '_blank' ? rel || 'noopener noreferrer' : rel}
    aria-label={ariaLabel}
    {...rest}
  >
    <slot />
  </a>
) : (
  <button
    type={type}
    class={combinedClass}
    id={id}
    aria-label={ariaLabel}
    {...rest}
  >
    <slot />
  </button>
)}
