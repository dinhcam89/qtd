---
interface Props {
  class?: string;
  as?: 'div' | 'section' | 'article' | 'main' | 'footer' | 'header';
}

const { class: className = '', as = 'div' } = Astro.props;
const Tag = as as any;
---

<Tag
  class:list={[
    'max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12 w-full',
    className,
  ]}
>
  <slot />
</Tag>
