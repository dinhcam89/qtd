---
import { DEFAULT_FALLBACK_TEXT } from '../../lib/constants';
import { formatDate } from '../../lib/format';

interface Props {
  label: string;
  value?: string | number | null;
  unit?: string;
  asOf?: Date | string | null;
  class?: string;
}

const { label, value, unit, asOf, class: className = '' } = Astro.props;

const isNullValue =
  value === null ||
  value === undefined ||
  value === '' ||
  value === DEFAULT_FALLBACK_TEXT ||
  value === 'Đang cập nhật';

// Dòng "Tính đến ..." chỉ hiển thị khi as_of có giá trị hợp lệ (khác null / "Đang cập nhật")
let formattedAsOfDate: string | null = null;
if (asOf && asOf !== DEFAULT_FALLBACK_TEXT && asOf !== 'Đang cập nhật') {
  if (typeof asOf === 'string' && asOf.startsWith('tính đến ')) {
    formattedAsOfDate = asOf.replace(/^tính đến\s+/i, '').trim();
  } else if (
    asOf instanceof Date ||
    (typeof asOf === 'string' && !isNaN(Date.parse(asOf)))
  ) {
    const formatted = formatDate(asOf, '');
    if (formatted && formatted !== DEFAULT_FALLBACK_TEXT) {
      formattedAsOfDate = formatted;
    }
  } else if (typeof asOf === 'string' && asOf.trim() !== '') {
    formattedAsOfDate = asOf.trim();
  }
}

const valueStr = value != null ? String(value).trim() : '';
const valueLength = valueStr.length;

// Tự động điều chỉnh cỡ chữ theo độ dài để các con số tiền tệ lớn (15 tỷ, 120 tỷ...) không bị tràn box
let valueSizeClass = 'text-stat leading-none';
if (valueLength > 18) {
  valueSizeClass = 'text-lg sm:text-xl min-[1280px]:text-2xl leading-tight';
} else if (valueLength > 11) {
  valueSizeClass =
    'text-xl sm:text-2xl min-[1280px]:text-[1.75rem] leading-tight';
} else if (valueLength > 6) {
  valueSizeClass = 'text-2xl sm:text-3xl leading-snug';
}
---

<div
  data-stat-card
  class:list={[
    'flex flex-col justify-between h-full p-5 sm:p-6 rounded-lg bg-surface-page border border-border-default shadow-xs min-w-0 overflow-hidden',
    className,
  ]}
>
  <div class="min-w-0">
    <div
      data-stat-label
      class="text-base font-medium text-ink-muted mb-2 text-balance [text-wrap:pretty]"
    >
      {label}
    </div>

    {isNullValue ? (
      <div
        data-stat-fallback
        class="text-lg font-medium text-ink-muted whitespace-nowrap leading-snug"
      >
        Đang cập nhật
      </div>
    ) : (
      <div
        data-stat-value
        class:list={[
          valueSizeClass,
          'font-bold text-brand-primary tracking-tight break-words [overflow-wrap:anywhere]',
        ]}
      >
        {value}
        {unit && (
          <span
            data-stat-unit
            class="text-base font-normal text-ink-muted ml-1"
          >
            {unit}
          </span>
        )}
      </div>
    )}
  </div>

  {formattedAsOfDate && (
    <div
      data-stat-asof
      class="text-sm text-ink-muted mt-4 pt-3 border-t border-border-default"
    >
      Tính đến {formattedAsOfDate}
    </div>
  )}
</div>
