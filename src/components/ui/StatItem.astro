---
import { DEFAULT_FALLBACK_TEXT } from '../../lib/constants';

interface Props {
  label: string;
  value?: string | number | null;
  unit?: string;
  asOf?: string;
  class?: string;
}

const { label, value, unit, asOf, class: className = '' } = Astro.props;

const isNullValue =
  value === null ||
  value === undefined ||
  value === '' ||
  value === DEFAULT_FALLBACK_TEXT ||
  value === 'Đang cập nhật';
---

<div
  data-stat-card
  class:list={[
    'flex flex-col justify-between h-full p-5 sm:p-6 rounded-lg bg-surface-page border border-border-default shadow-xs',
    className,
  ]}
>
  <div>
    <div data-stat-label class="text-base font-medium text-ink-muted mb-2">
      {label}
    </div>

    {isNullValue ? (
      <div
        data-stat-fallback
        class="text-lg font-medium text-ink-muted whitespace-nowrap leading-snug"
      >
        Đang cập nhật
      </div>
    ) : (
      <div
        data-stat-value
        class="text-stat font-bold text-brand-primary tracking-tight leading-none"
      >
        {value}
        {unit && (
          <span data-stat-unit class="text-base font-normal text-ink-muted ml-1">
            {unit}
          </span>
        )}
      </div>
    )}
  </div>

  {asOf && (
    <div class="text-sm text-ink-muted mt-4 pt-3 border-t border-border-default">
      Tính đến {asOf}
    </div>
  )}
</div>
