---
interface Props {
  title: string;
  description?: string;
  href?: string;
  date?: string;
  badge?: string;
  class?: string;
}

const {
  title,
  description,
  href,
  date,
  badge,
  class: className = '',
} = Astro.props;
---

<article
  class:list={[
    'group flex flex-col justify-between h-full p-6 rounded-lg bg-surface-page border border-border-default shadow-xs hover:border-brand-primary/50 transition-colors relative',
    className,
  ]}
>
  <div>
    {badge && (
      <span class="inline-block text-xs font-semibold text-brand-primary bg-surface-brand-subtle px-2.5 py-1 rounded-sm mb-3">
        {badge}
      </span>
    )}

    <h3 class="text-xl font-semibold text-ink-base group-hover:text-brand-primary transition-colors mb-2">
      {href ? (
        <a
          href={href}
          class="focus:outline-hidden after:absolute after:inset-0"
        >
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    {description && (
      <p class="text-base text-ink-muted leading-relaxed mb-4">{description}</p>
    )}
  </div>

  {date && (
    <div class="text-sm text-ink-muted mt-auto pt-3 border-t border-border-default flex items-center justify-between">
      <time datetime={date}>{date}</time>
      {href && (
        <span
          class="text-brand-primary font-medium text-sm flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
          aria-hidden="true"
        >
          Xem thêm &rarr;
        </span>
      )}
    </div>
  )}
</article>
