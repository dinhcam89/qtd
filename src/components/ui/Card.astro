---
interface Props {
  title: string;
  description?: string;
  href?: string;
  date?: string;
  /** Giá trị ISO (yyyy-mm-dd) cho thuộc tính datetime của thẻ time. */
  dateTime?: string;
  badge?: string;
  /** Ảnh minh họa (alt bắt buộc). */
  image?: { src: string; alt: string };
  class?: string;
}

const {
  title,
  description,
  href,
  date,
  dateTime,
  badge,
  image,
  class: className = '',
} = Astro.props;
---

<article
  class:list={[
    'group flex flex-col justify-between h-full p-6 rounded-2xl bg-surface-page border border-emerald-200/80 shadow-xs hover:border-brand-primary transition-colors relative',
    className,
  ]}
>
  <div>
    {image && (
      <img
        src={image.src}
        alt={image.alt}
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        class="w-full h-auto aspect-video object-cover rounded-xl mb-4"
      />
    )}

    {badge && (
      <span class="inline-block text-xs font-bold text-brand-dark bg-emerald-100/80 border border-emerald-300 px-3 py-1 rounded-full mb-3">
        {badge}
      </span>
    )}

    <h3 class="text-xl font-semibold text-ink-base group-hover:text-brand-primary transition-colors mb-2 break-words">
      {href ? (
        <a
          href={href}
          class="focus:outline-hidden after:absolute after:inset-0"
        >
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    {description && (
      <p class="text-base text-ink-muted leading-relaxed mb-4">{description}</p>
    )}
  </div>

  {date && (
    <div class="text-sm text-ink-muted mt-auto pt-3 border-t border-border-default flex items-center justify-between">
      <time datetime={dateTime ?? date}>{date}</time>
      {href && (
        <span
          class="text-brand-primary font-semibold text-sm flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
          aria-hidden="true"
        >
          Xem thêm &rarr;
        </span>
      )}
    </div>
  )}
</article>
