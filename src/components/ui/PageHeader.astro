---
import Container from './Container.astro';
import Breadcrumb from './Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumb?: BreadcrumbItem[];
}

const { title, description, breadcrumb } = Astro.props;
---

<section class="relative w-full overflow-hidden border-b border-emerald-900/10 bg-gradient-to-b from-[#d9f2e6] via-[#e8f7ee] to-[#f0faf4] py-8 md:py-12">
  <!-- Nền phong cảnh đồi lúa xanh QTDND nhẹ nhàng đồng bộ trang chủ -->
  <div
    class="absolute inset-0 w-full h-full pointer-events-none select-none overflow-hidden"
    aria-hidden="true"
  >
    <div class="absolute top-2 right-8 sm:right-20 w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-[radial-gradient(circle,_rgba(253,224,71,0.55)_0%,_rgba(253,224,71,0)_70%)]"></div>
    <svg
      class="absolute bottom-0 inset-x-0 w-full h-[65%] object-cover"
      preserveAspectRatio="none"
      viewBox="0 0 1440 220"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,90 Q360,30 720,85 T1440,55 L1440,220 L0,220 Z"
        fill="#a7d8b5"
        opacity="0.3"
      ></path>
      <path
        d="M0,135 C360,85 720,155 1080,105 C1260,80 1380,115 1440,110 L1440,220 L0,220 Z"
        fill="#6cc287"
        opacity="0.3"
      ></path>
      <path
        d="M0,175 Q480,135 960,170 T1440,155 L1440,220 L0,220 Z"
        fill="#d8e878"
        opacity="0.35"
      ></path>
    </svg>
  </div>

  <Container class="relative z-10">
    {breadcrumb && breadcrumb.length > 0 && (
      <Breadcrumb items={breadcrumb} class="mb-4" />
    )}
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-brand-primary">
      {title}
    </h1>
    {description && (
      <p class="mt-3 text-base sm:text-lg text-ink-muted max-w-3xl leading-relaxed">
        {description}
      </p>
    )}
    <slot />
  </Container>
</section>
