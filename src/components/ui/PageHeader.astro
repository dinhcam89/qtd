---
import Container from './Container.astro';
import Breadcrumb from './Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumb?: BreadcrumbItem[];
}

const { title, description, breadcrumb } = Astro.props;
---

<section class="border-b border-border-default bg-surface-muted py-8 md:py-12">
  <Container>
    {breadcrumb && breadcrumb.length > 0 && (
      <Breadcrumb items={breadcrumb} class="mb-4" />
    )}
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-brand-primary">
      {title}
    </h1>
    {description && (
      <p class="mt-3 text-base sm:text-lg text-ink-muted max-w-3xl">
        {description}
      </p>
    )}
    <slot />
  </Container>
</section>
