---
import { getNewsListHref } from '../lib/news';

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
const linkClass =
  'inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3.5 rounded-xl border border-emerald-200/80 bg-surface-page text-base font-medium text-ink-base hover:border-brand-primary hover:text-brand-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus transition-colors';
---

{totalPages > 1 && (
  <nav aria-label="Phân trang tin tức" data-pagination class="mt-10">
    <ul class="flex flex-wrap items-center gap-2">
      {page > 1 && (
        <li>
          <a
            href={getNewsListHref(page - 1)}
            rel="prev"
            data-pagination-prev
            class={linkClass}
          >
            Trước
          </a>
        </li>
      )}
      {pages.map((p) => (
        <li>
          {p === page ? (
            <span
              aria-current="page"
              class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] px-3.5 rounded-xl bg-brand-primary text-white text-base font-semibold shadow-2xs"
            >
              {p}
            </span>
          ) : (
            <a
              href={getNewsListHref(p)}
              aria-label={`Trang ${p}`}
              class={linkClass}
            >
              {p}
            </a>
          )}
        </li>
      ))}
      {page < totalPages && (
        <li>
          <a
            href={getNewsListHref(page + 1)}
            rel="next"
            data-pagination-next
            class={linkClass}
          >
            Sau
          </a>
        </li>
      )}
    </ul>
  </nav>
)}
