---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from './ui/Container.astro';
import Section from './ui/Section.astro';
import PageHeader from './ui/PageHeader.astro';
import Card from './ui/Card.astro';
import Pagination from './Pagination.astro';
import { getSite } from '../lib/data';
import {
  getPublishedNews,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../lib/news';
import { paginate } from '../lib/pagination';
import { formatText, formatDate, formatDateIso } from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

interface Props {
  page: number;
}

const { page: requestedPage } = Astro.props;
const site = await getSite();
const news = await getPublishedNews();
const { items, page, totalPages } = paginate(news, requestedPage);

const siteName = formatText(site.name);
const pageTitle =
  (page > 1 ? `Tin tức — Trang ${page} — ` : 'Tin tức — ') +
  `Quỹ tín dụng nhân dân ${siteName}`;
const pageDescription =
  page > 1
    ? `Tin tức, thông báo và hoạt động của Quỹ tín dụng nhân dân ${siteName} (Trang ${page}/${totalPages}).`
    : `Tin tức, thông báo và hoạt động của Quỹ tín dụng nhân dân ${siteName}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader
    title="Tin tức"
    description="Tin tức, thông báo và hoạt động của Quỹ."
    breadcrumb={[{ label: 'Trang chủ', href: '/' }, { label: 'Tin tức' }]}
  />

  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="space-y-8">
        <div data-notice-link>
          <Card
            title="Thông báo và lịch làm việc"
            description="Lịch làm việc thường xuyên, các kỳ nghỉ và thông báo mới nhất của Quỹ."
            href="/thong-bao"
          />
        </div>

        {items.length === 0 ? (
          <div
            data-news-empty
            class="p-8 text-center rounded-lg border border-border-default bg-surface-muted"
          >
            <p class="text-ink-muted text-base sm:text-lg">
              {DEFAULT_FALLBACK_TEXT}
            </p>
          </div>
        ) : (
          <>
            <ul data-news-list class="grid grid-cols-1 gap-6">
              {items.map((entry) => (
                <li data-news-item>
                  <Card
                    title={entry.data.title}
                    description={entry.data.description}
                    href={getNewsDetailHref(entry.id)}
                    date={formatDate(entry.data.pubDate)}
                    dateTime={formatDateIso(entry.data.pubDate)}
                    badge={getNewsCategoryLabel(entry.data.category)}
                    image={entry.data.image}
                  />
                </li>
              ))}
            </ul>
            <Pagination page={page} totalPages={totalPages} />
          </>
        )}
      </div>
    </Container>
  </Section>
</BaseLayout>
