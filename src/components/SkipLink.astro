---
interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'main-content', label = 'Chuyển đến nội dung chính' } =
  Astro.props;
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-3 focus:bg-brand-primary focus:text-white focus:font-semibold focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-brand-primary"
>
  {label}
</a>
