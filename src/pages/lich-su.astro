---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import { getSite, getPageEntry } from '../lib/data';
import { formatText, formatDate } from '../lib/format';
import { render } from 'astro:content';

const site = await getSite();
const pageEntry = await getPageEntry('lich-su');
const { Content: LichSuContent } = await render(pageEntry);

const pageTitle = `Lịch sử hình thành — Quỹ tín dụng nhân dân ${formatText(site.name)}`;
const pageDescription = pageEntry.data.description;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero / Tiêu đề trang -->
  <section class="border-b border-border-default bg-surface-muted py-8 md:py-12">
    <Container>
      <!-- Breadcrumb -->
      <nav
        aria-label="Đường dẫn điều hướng"
        class="mb-4 text-sm text-ink-muted"
      >
        <ol class="flex items-center space-x-2">
          <li>
            <a
              href="/"
              class="hover:text-brand-primary focus-visible:outline-2 focus-visible:outline-border-focus rounded"
            >
              Trang chủ
            </a>
          </li>
          <li aria-hidden="true" class="text-border-strong">
            /
          </li>
          <li>
            <a
              href="/gioi-thieu"
              class="hover:text-brand-primary focus-visible:outline-2 focus-visible:outline-border-focus rounded"
            >
              Giới thiệu
            </a>
          </li>
          <li aria-hidden="true" class="text-border-strong">
            /
          </li>
          <li class="font-medium text-ink-base" aria-current="page">
            Lịch sử hình thành
          </li>
        </ol>
      </nav>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-brand-primary">
        Lịch sử hình thành và phát triển
      </h1>
      <p class="mt-3 text-base sm:text-lg text-ink-muted max-w-3xl">
        {pageEntry.data.description}
      </p>
      <p class="mt-2 text-sm text-ink-subtle">
        Cập nhật: {formatDate(pageEntry.data.updated)}
      </p>
    </Container>
  </section>

  <!-- Nội dung lịch sử -->
  <Section class="bg-surface-page">
    <div class="max-w-3xl mx-auto space-y-8">
      <div class="prose max-w-none text-ink-base space-y-4">
        <LichSuContent />
      </div>

      <!-- Điều hướng tiếp -->
      <div class="pt-8 border-t border-border-default">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Card
            title="Giới thiệu chung"
            description="Tìm hiểu tôn chỉ, mục đích hoạt động và thông tin pháp lý của Quỹ."
            href="/gioi-thieu"
          />
          <Card
            title="Ban lãnh đạo"
            description="Cơ cấu Hội đồng quản trị, Ban kiểm soát và Ban điều hành của Quỹ."
            href="/ban-lanh-dao"
          />
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
