---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import { getSite, getPageEntry } from '../lib/data';
import { formatText, formatDate } from '../lib/format';
import { render } from 'astro:content';

const site = await getSite();
const pageEntry = await getPageEntry('lich-su');
const { Content: LichSuContent } = await render(pageEntry);

const pageTitle = `Lịch sử hình thành — Quỹ tín dụng nhân dân ${formatText(site.name)}`;
const pageDescription = pageEntry.data.description;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader
    title="Lịch sử hình thành và phát triển"
    description={pageEntry.data.description}
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Giới thiệu', href: '/gioi-thieu' },
      { label: 'Lịch sử hình thành' },
    ]}
  >
    <p class="mt-2 text-sm text-ink-subtle font-medium">
      Cập nhật: {formatDate(pageEntry.data.updated)}
    </p>
  </PageHeader>

  <!-- Nội dung lịch sử -->
  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="space-y-10">
        <!-- Dấu mốc truyền thống nổi bật -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 max-w-3xl">
          <div class="p-6 rounded-2xl bg-surface-brand-subtle border border-emerald-200/80 space-y-1.5">
            <span class="text-xs font-extrabold uppercase tracking-wider text-brand-dark">
              Khởi nguồn truyền thống
            </span>
            <div class="text-xl sm:text-2xl font-extrabold text-brand-primary">
              Hợp tác xã Tín dụng
            </div>
            <p class="text-sm text-ink-muted leading-relaxed">
              Hình thành từ phong trào hợp tác xã tín dụng địa phương, đặt nền
              móng tương trợ vốn cho sản xuất nông nghiệp và đời sống nhân dân.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-surface-brand-subtle border border-emerald-200/80 space-y-1.5">
            <span class="text-xs font-extrabold uppercase tracking-wider text-brand-dark">
              Phát triển hiện đại
            </span>
            <div class="text-xl sm:text-2xl font-extrabold text-brand-primary">
              Quỹ tín dụng nhân dân
            </div>
            <p class="text-sm text-ink-muted leading-relaxed">
              Hoạt động theo mô hình Quỹ tín dụng nhân dân vững mạnh, an toàn,
              đồng hành bền bỉ cùng sự phát triển kinh tế địa phương.
            </p>
          </div>
        </div>

        <div class="content-body max-w-3xl">
          <LichSuContent />
        </div>

        <!-- Điều hướng tiếp -->
        <div class="pt-8 border-t border-border-default">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Card
              title="Giới thiệu chung"
              description="Tìm hiểu tôn chỉ, mục đích hoạt động và thông tin pháp lý của Quỹ."
              href="/gioi-thieu"
            />
            <Card
              title="Ban lãnh đạo"
              description="Cơ cấu Hội đồng quản trị, Ban kiểm soát và Ban điều hành của Quỹ."
              href="/ban-lanh-dao"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
