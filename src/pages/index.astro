---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import LinkButton from '../components/ui/LinkButton.astro';
import StatItem from '../components/ui/StatItem.astro';
import Card from '../components/ui/Card.astro';
import RatesTables from '../components/RatesTables.astro';
import { getSite, getRates } from '../lib/data';
import {
  getPublishedNews,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../lib/news';
import {
  formatAsOf,
  formatDate,
  formatDateIso,
  formatNumber,
  formatCurrency,
  formatText,
} from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const site = await getSite();
const rates = await getRates();
const publishedNews = await getPublishedNews();

const siteTitle = site.name
  ? `Trang chủ — Quỹ tín dụng nhân dân ${site.name}`
  : 'Trang chủ — Quỹ tín dụng nhân dân';
const siteDescription =
  formatText(site.description) ||
  `Cổng thông tin Quỹ tín dụng nhân dân ${site.name}`;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <!-- 1. Hero Section -->
  <Section
    variant="default"
    class="border-b border-border-default pt-8 pb-12 sm:pt-12 sm:pb-16"
  >
    <Container>
      <div class="max-w-3xl space-y-5">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-primary tracking-tight leading-tight">
          {formatText(site.name)}
        </h1>
        <p class="text-lg sm:text-xl text-ink-muted leading-relaxed">
          {formatText(site.description)}
        </p>
        <div
          data-hero-actions
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2"
        >
          <LinkButton
            data-hero-btn
            href="#lai-suat"
            variant="primary"
            class="w-full sm:w-auto text-center"
          >
            Xem biểu lãi suất
          </LinkButton>
          <LinkButton
            data-hero-btn
            href="#lien-he"
            variant="secondary"
            class="w-full sm:w-auto text-center"
          >
            Thông tin liên hệ
          </LinkButton>
        </div>
      </div>
    </Container>
  </Section>

  <!-- 2. Khối Số liệu quy mô (#quy-mo) -->
  <Section id="quy-mo" data-scale-section variant="muted" class="scroll-mt-20">
    <Container>
      <div data-page-content class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h2 class="text-2xl font-bold text-ink-base">Quy mô hoạt động</h2>
          <p class="text-sm text-ink-muted">
            {site.stats.as_of
              ? `Số liệu ${formatAsOf(site.stats.as_of)}`
              : `Số liệu: ${DEFAULT_FALLBACK_TEXT}`}
          </p>
        </div>

        <!-- Lưới thẻ quy mô: 1 cột dưới 480px, 2 cột từ 480px đến dưới lg, 4 cột từ lg -->
        <div
          data-scale-grid
          class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 items-stretch"
        >
          <StatItem
            label="Tổng thành viên"
            value={
              site.stats.members_count != null
                ? formatNumber(site.stats.members_count)
                : null
            }
            unit="thành viên"
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Vốn điều lệ"
            value={
              site.stats.charter_capital != null
                ? formatCurrency(site.stats.charter_capital)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Tổng tài sản"
            value={
              site.stats.total_assets != null
                ? formatCurrency(site.stats.total_assets)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Dư nợ cho vay"
            value={
              site.stats.total_loans != null
                ? formatCurrency(site.stats.total_loans)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />
        </div>
      </div>
    </Container>
  </Section>

  <!-- 3. Khối Lãi suất tóm tắt (#lai-suat) -->
  <Section
    id="lai-suat"
    data-rates-section
    variant="default"
    class="scroll-mt-20"
  >
    <Container>
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-ink-base">
            Biểu lãi suất tham khảo
          </h2>
          <p class="text-sm text-ink-muted mt-1">
            {rates.effective_from
              ? `Áp dụng từ ngày ${formatDate(rates.effective_from)}`
              : `Thời điểm áp dụng: ${DEFAULT_FALLBACK_TEXT}`}
          </p>
        </div>

        <RatesTables rates={rates} headingLevel="h3" />
      </div>
    </Container>
  </Section>

  <!-- 4. Khối Tin mới (Ẩn hoàn toàn nếu chưa có bài công khai, đã lọc draft: true) -->
  {publishedNews.length > 0 && (
    <Section id="tin-tuc" variant="muted" class="scroll-mt-20">
      <Container>
        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-ink-base">Tin tức & Thông báo</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            {publishedNews.slice(0, 3).map((item) => (
              <Card
                title={item.data.title}
                description={item.data.description}
                href={getNewsDetailHref(item.id)}
                badge={getNewsCategoryLabel(item.data.category)}
                date={formatDate(item.data.pubDate)}
                dateTime={formatDateIso(item.data.pubDate)}
              />
            ))}
          </div>
          <p>
            <a
              data-home-news-link
              href="/tin-tuc/"
              class="inline-flex items-center min-h-[44px] font-medium text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
            >
              Xem tất cả tin tức &rarr;
            </a>
          </p>
        </div>
      </Container>
    </Section>
  )}
</BaseLayout>
