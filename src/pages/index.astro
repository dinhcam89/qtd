---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import LinkButton from '../components/ui/LinkButton.astro';
import StatItem from '../components/ui/StatItem.astro';
import DataTable from '../components/ui/DataTable.astro';
import Notice from '../components/ui/Notice.astro';
import Card from '../components/ui/Card.astro';
import { getSite, getRates } from '../lib/data';
import { getPublishedNews } from '../lib/news';
import {
  formatAsOf,
  formatDate,
  formatNumber,
  formatCurrency,
  formatPercent,
  formatText,
} from '../lib/format';
import { RATE_DISCLAIMER, DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const site = await getSite();
const rates = await getRates();
const publishedNews = await getPublishedNews();

const siteTitle = site.name
  ? `Trang chủ — Quỹ tín dụng nhân dân ${site.name}`
  : 'Trang chủ — Quỹ tín dụng nhân dân';
const siteDescription =
  formatText(site.description) ||
  `Cổng thông tin Quỹ tín dụng nhân dân ${site.name}`;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <!-- 1. Hero Section -->
  <Section
    variant="default"
    class="border-b border-border-default pt-8 pb-12 sm:pt-12 sm:pb-16"
  >
    <Container>
      <div class="max-w-3xl space-y-5">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-primary tracking-tight leading-tight">
          {formatText(site.name)}
        </h1>
        <p class="text-lg sm:text-xl text-ink-muted leading-relaxed">
          {formatText(site.description)}
        </p>
        <div
          data-hero-actions
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2"
        >
          <LinkButton
            data-hero-btn
            href="#lai-suat"
            variant="primary"
            class="w-full sm:w-auto text-center"
          >
            Xem biểu lãi suất
          </LinkButton>
          <LinkButton
            data-hero-btn
            href="#lien-he"
            variant="secondary"
            class="w-full sm:w-auto text-center"
          >
            Thông tin liên hệ
          </LinkButton>
        </div>
      </div>
    </Container>
  </Section>

  <!-- 2. Khối Số liệu quy mô (#quy-mo) -->
  <Section id="quy-mo" variant="muted" class="scroll-mt-20">
    <Container>
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h2 class="text-2xl font-bold text-ink-base">Quy mô hoạt động</h2>
          <p class="text-sm text-ink-muted">
            {site.stats.as_of
              ? `Số liệu ${formatAsOf(site.stats.as_of)}`
              : `Số liệu: ${DEFAULT_FALLBACK_TEXT}`}
          </p>
        </div>

        <!-- Lưới thẻ quy mô: 1 cột dưới 480px, 2 cột từ 480px đến dưới lg, 4 cột từ lg -->
        <div
          data-scale-grid
          class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 items-stretch"
        >
          <StatItem
            label="Tổng thành viên"
            value={site.stats.members_count != null ? formatNumber(site.stats.members_count) : null}
            unit="thành viên"
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Vốn điều lệ"
            value={site.stats.charter_capital != null ? formatCurrency(site.stats.charter_capital) : null}
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Tổng tài sản"
            value={site.stats.total_assets != null ? formatCurrency(site.stats.total_assets) : null}
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Dư nợ cho vay"
            value={site.stats.total_loans != null ? formatCurrency(site.stats.total_loans) : null}
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />
        </div>
      </div>
    </Container>
  </Section>

  <!-- 3. Khối Lãi suất tóm tắt (#lai-suat) -->
  <Section id="lai-suat" variant="default" class="scroll-mt-20">
    <Container>
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-ink-base">
            Biểu lãi suất tham khảo
          </h2>
          <p class="text-sm text-ink-muted mt-1">
            {rates.effective_from
              ? `Áp dụng từ ngày ${formatDate(rates.effective_from)}`
              : `Thời điểm áp dụng: ${DEFAULT_FALLBACK_TEXT}`}
          </p>
        </div>

        <!-- Bảng 1: Lãi suất tiền gửi (một thẻ table duy nhất, CSS chuyển sang card trên mobile) -->
        <div class="space-y-3">
          <h3 class="text-xl font-semibold text-brand-primary">
            Lãi suất tiền gửi
          </h3>
          <DataTable class="shadow-xs">
            <thead>
              <tr class="border-b border-border-default bg-surface-muted text-ink-base text-base font-semibold">
                <th scope="col" class="py-3.5 px-4 text-left">
                  Kỳ hạn
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Lãi suất (%/năm)
                </th>
                <th scope="col" class="py-3.5 px-4 text-left">
                  Ghi chú
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-default text-base">
              {rates.deposit_rates.map((item) => (
                <tr class="hover:bg-surface-muted/50 transition-colors">
                  <td
                    data-label="Kỳ hạn"
                    class="py-3.5 px-4 font-medium text-ink-base text-left"
                  >
                    {formatText(item.term)}
                  </td>
                  <td
                    data-label="Lãi suất (%/năm)"
                    class="py-3.5 px-4 font-bold text-brand-primary text-right"
                  >
                    {formatPercent(item.rate)}
                  </td>
                  <td
                    data-label="Ghi chú"
                    class="py-3.5 px-4 text-ink-muted text-left"
                  >
                    {formatText(item.note, '—')}
                  </td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        </div>

        <!-- Bảng 2: Lãi suất cho vay (một thẻ table duy nhất, CSS chuyển sang card trên mobile) -->
        <div class="space-y-3 pt-2">
          <h3 class="text-xl font-semibold text-brand-primary">
            Lãi suất cho vay
          </h3>
          <DataTable class="shadow-xs">
            <thead>
              <tr class="border-b border-border-default bg-surface-muted text-ink-base text-base font-semibold">
                <th scope="col" class="py-3.5 px-4 text-left">
                  Mục đích vay
                </th>
                <th scope="col" class="py-3.5 px-4 text-left">
                  Kỳ hạn
                </th>
                <th scope="col" class="py-3.5 px-4 text-right">
                  Lãi suất (%/năm)
                </th>
                <th scope="col" class="py-3.5 px-4 text-left">
                  Ghi chú
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-default text-base">
              {rates.loan_rates.map((item) => (
                <tr class="hover:bg-surface-muted/50 transition-colors">
                  <td
                    data-label="Mục đích vay"
                    class="py-3.5 px-4 font-medium text-ink-base text-left"
                  >
                    {formatText(item.purpose)}
                  </td>
                  <td
                    data-label="Kỳ hạn"
                    class="py-3.5 px-4 text-ink-muted text-left"
                  >
                    {formatText(item.term, '—')}
                  </td>
                  <td
                    data-label="Lãi suất (%/năm)"
                    class="py-3.5 px-4 font-bold text-brand-primary text-right"
                  >
                    {formatPercent(item.rate)}
                  </td>
                  <td
                    data-label="Ghi chú"
                    class="py-3.5 px-4 text-ink-muted text-left"
                  >
                    {formatText(item.note, '—')}
                  </td>
                </tr>
              ))}
            </tbody>
          </DataTable>
        </div>

        <!-- Dòng lưu ý lãi suất bắt buộc (Notice component, >= 16px, không in nghiêng) -->
        <Notice variant="warning">{RATE_DISCLAIMER}</Notice>
      </div>
    </Container>
  </Section>

  <!-- 4. Khối Tin mới (Ẩn hoàn toàn nếu chưa có bài công khai, đã lọc draft: true) -->
  {publishedNews.length > 0 && (
    <Section id="tin-tuc" variant="muted" class="scroll-mt-20">
      <Container>
        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-ink-base">Tin tức & Thông báo</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            {publishedNews.slice(0, 3).map((item) => (
              <Card
                title={item.data.title}
                description={item.data.description}
                badge={item.data.category}
                date={formatDate(item.data.pubDate)}
              />
            ))}
          </div>
        </div>
      </Container>
    </Section>
  )}
</BaseLayout>
