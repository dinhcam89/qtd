                  validDepositOptions.map((termItem) => {
                    const matchMonth = termItem.term.match(/\d+/);
                    const monthCount = matchMonth ? matchMonth[0] : '12';
                    const rateStr =
                      termItem.rate !== null
                        ? termItem.rate.toString().replace('.', ',')
                        : '0';
                    return (
                      <option
                        value={monthCount}
                        data-rate={termItem.rate || 0}
                        selected={termItem.term.includes('12')}
                      >
                        {termItem.term} — Lãi suất: {rateStr}%/năm (
