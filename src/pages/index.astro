            </div>
          </a>

          <a
            href="#tinh-lai"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary truncate">
                Tính lãi dự kiến
              </div>
              <div class="text-[11px] text-ink-muted truncate">
                Công cụ trực quan
              </div>
            </div>
          </a>

          <a
            href="#quy-mo"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-brand-dark flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                ></path>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary truncate">
                Quy mô &amp; Uy tín
              </div>
              <div class="text-[11px] text-ink-muted truncate">
                Số liệu minh bạch
              </div>
            </div>
          </a>

          <a
            href="#tin-tuc"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-purple-100 text-purple-800 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
                ></path>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary truncate">
                Tin nổi bật
              </div>
              <div class="text-[11px] text-ink-muted truncate">
                Thông báo từ Quỹ
              </div>
            </div>
          </a>

          <a
            href="/lien-he"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group col-span-2 sm:col-span-1"
          >
            <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-800 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
            </div>
            <div class="min-w-0">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary truncate">
                Hội sở &amp; Liên hệ
              </div>
              <div class="text-[11px] text-ink-muted truncate">
                Chỉ đường Google Maps
              </div>
            </div>
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. Khối Slider Hình ảnh Hoạt động Tiêu biểu -->
  <section
    aria-label="Hình ảnh hoạt động tiêu biểu"
    class="pt-10 pb-8 sm:pt-14 sm:pb-10"
  >
    <Container>
      <HomeSlider />
    </Container>
  </section>

  <!-- 4. Công cụ Ước tính Tiền lãi Tiết kiệm Tương tác (#tinh-lai) -->
  <Section
    id="tinh-lai"
    variant="brand-subtle"
    class="scroll-mt-20 border-y border-emerald-200/70"
  >
    <Container>
      <div
        data-poc-calculator
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
      >
        <div class="lg:col-span-7 space-y-6 bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm border border-emerald-200/80">
          <div class="space-y-2">
            <h2 class="text-2xl sm:text-3xl font-bold text-ink-base">
              Ước tính tiền lãi tiết kiệm
            </h2>
            <p class="text-sm text-ink-muted">
              Giúp bà con và thành viên chủ động tính toán khoản tiền lãi dự
              kiến nhận được theo từng kỳ hạn gửi tại Quỹ.
            </p>
          </div>

          <div class="space-y-5 pt-2">
            <div class="space-y-2">
              <div class="flex justify-between items-baseline">
                <label
                  for="calc-amount-input"
                  class="text-sm font-bold text-ink-base"
                >
                  Số tiền dự kiến gửi (VNĐ):
                </label>
                <span
                  id="calc-amount-display"
                  class="text-base font-extrabold text-brand-primary"
                >
                  50.000.000 đồng
                </span>
              </div>
              <input
                id="calc-amount-input"
                type="range"
                min="5000000"
                max="1000000000"
                step="5000000"
                value="50000000"
                class="w-full h-2.5 bg-emerald-100 rounded-lg appearance-none cursor-pointer accent-brand-primary"
              />
              <div class="flex flex-wrap gap-2 pt-1">
                {[10000000, 50000000, 100000000, 200000000, 500000000].map(
                  (preset) => (
                    <button
                      type="button"
                      data-amount-preset={preset}
                      class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-emerald-200 bg-surface-brand-subtle text-brand-dark hover:bg-brand-primary hover:text-white transition-colors cursor-pointer"
                    >
                      {preset / 1000000} triệu
                    </button>
                  )
                )}
              </div>
            </div>

            <div class="space-y-2">
              <label
                for="calc-term-select"
                class="block text-sm font-bold text-ink-base"
              >
                Chọn kỳ hạn gửi tiết kiệm:
              </label>
              <select
                id="calc-term-select"
                class="w-full rounded-xl border border-border-strong bg-surface-page px-4 py-3 text-sm font-semibold text-ink-base focus:outline-2 focus:outline-brand-primary"
              >
                {validDepositOptions.length > 0 ? (
                  validDepositOptions.map((item, idx) => {
                    const monthsMatch = item.term.match(/(\d+)/);
                    const months = monthsMatch
                      ? parseInt(monthsMatch[1], 10)
                      : 12;
                    const isDefault = item.term.includes('12') || idx === 0;
                    return (
                      <option
                        value={months}
                        data-rate={item.rate}
                        selected={isDefault}
                      >
                        {item.term} — Lãi suất{' '}
                        {item.rate?.toString().replace('.', ',')}%/năm
                      </option>
                    );
                  })
                ) : (
                  <option value="12" data-rate="0" selected>
                    12 tháng — {DEFAULT_FALLBACK_TEXT}
                  </option>
                )}
              </select>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-3xl bg-[#014d27] bg-gradient-to-br from-[#006d35] via-[#015a30] to-[#014d27] p-6 sm:p-8 text-white shadow-xl space-y-5 border border-white/20">
            <div class="flex items-center justify-between border-b border-white/25 pb-4">
              <span class="text-xs uppercase font-bold tracking-wider text-white">
                Kết quả dự tính cuối kỳ
              </span>
              <span
                id="calc-applied-rate"
                class="text-xs font-extrabold px-3 py-1 rounded-full bg-black/30 text-[#ffd100]"
              >
                5,4%/năm
              </span>
            </div>

            <div class="space-y-1">
              <div class="text-xs text-white/95">
                Tiền lãi dự kiến nhận được:
              </div>
              <div
                id="calc-estimated-profit"
                class="text-2xl sm:text-3xl font-extrabold text-[#ffd100] mt-1"
              >
                2.700.000 đ
              </div>
            </div>

            <div class="border-t border-white/25 pt-4">
              <div class="text-xs text-white/95">
                Tổng tiền nhận được khi đáo hạn:
              </div>
              <div
                id="calc-total-received"
                class="text-lg sm:text-xl font-bold text-white mt-0.5"
              >
                52.700.000 đ
              </div>
            </div>

            <a
              href="/lien-he"
              class="block w-full text-center py-3 px-4 rounded-xl bg-[#ffd100] hover:bg-amber-300 text-emerald-950 font-extrabold text-sm transition-colors shadow-md mt-2"
            >
              Liên hệ mở sổ tiết kiệm ngay
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- 5. Khối Số liệu quy mô (#quy-mo) -->
  <Section
    id="quy-mo"
    data-scale-section
    variant="default"
    class="scroll-mt-20"
  >
    <Container>
      <div class="space-y-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="space-y-2 max-w-2xl">
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-4">
              <h2 class="text-2xl sm:text-3xl font-extrabold text-ink-base">
                Quy mô hoạt động
              </h2>
              <p class="text-sm text-ink-muted font-medium">
                {site.stats.as_of
                  ? `Số liệu ${formatAsOf(site.stats.as_of)}`
                  : `Số liệu: ${DEFAULT_FALLBACK_TEXT}`}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4 bg-white rounded-2xl p-4 border border-emerald-200/80 shadow-xs shrink-0">
            {hasBrandAssets && (
              <a
                href="https://div.gov.vn"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border-focus rounded shrink-0"
                title="Chứng nhận Bảo hiểm tiền gửi Việt Nam (DIV)"
                aria-label="Chứng nhận Bảo hiểm tiền gửi Việt Nam"
              >
                <img
                  src="/images/chung-nhan-bhtg-vn.png"
                  alt="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam"
                  width="145"
                  height="100"
                  class="h-14 sm:h-16 w-auto object-contain block"
                  loading="lazy"
                />
              </a>
            )}
            <div class="text-xs text-ink-muted max-w-xs leading-relaxed">
              <strong class="text-ink-base block text-sm">
                Tham gia Bảo hiểm tiền gửi
              </strong>
              Người gửi tiền được bảo vệ quyền và lợi ích hợp pháp theo quy định
              của Luật Bảo hiểm tiền gửi.
            </div>
          </div>
        </div>

        <div
          data-scale-grid
          class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 items-stretch"
        >
          <StatItem
            label="Tổng thành viên"
            value={
              site.stats.members_count != null
                ? formatNumber(site.stats.members_count)
                : null
            }
            unit="thành viên"
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
            class="rounded-2xl border-emerald-200/80 shadow-sm"
          />

          <StatItem
            label="Vốn điều lệ"
            value={
              site.stats.charter_capital != null
                ? formatCurrency(site.stats.charter_capital)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
            class="rounded-2xl border-emerald-200/80 shadow-sm"
          />

          <StatItem
            label="Tổng tài sản"
            value={
              site.stats.total_assets != null
                ? formatCurrency(site.stats.total_assets)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
            class="rounded-2xl border-emerald-200/80 shadow-sm"
          />

          <StatItem
            label="Dư nợ cho vay"
            value={
              site.stats.total_loans != null
                ? formatCurrency(site.stats.total_loans)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
            class="rounded-2xl border-emerald-200/80 shadow-sm"
          />
        </div>
      </div>
    </Container>
  </Section>

  <!-- 6. Khối Lãi suất tóm tắt (#lai-suat) -->
  <Section
    id="lai-suat"
    data-rates-section
    variant="default"
    class="scroll-mt-20"
  >
    <Container>
      <div class="space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 border-b border-border-default pb-4">
          <div>
            <span class="text-xs uppercase font-extrabold tracking-widest text-brand-primary">
              Minh bạch &amp; Cạnh tranh
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-ink-base mt-1">
              Biểu lãi suất tham khảo
            </h2>
            <p class="text-sm text-ink-muted mt-1">
              {rates.effective_from
                ? `Áp dụng từ ngày ${formatDate(rates.effective_from)}`
                : `Thời điểm áp dụng: ${DEFAULT_FALLBACK_TEXT}`}
            </p>
          </div>
          <a
            href="/lai-suat"
            class="inline-flex items-center text-sm font-bold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-border-focus rounded"
          >
            Xem chi tiết biểu lãi suất &rarr;
          </a>
        </div>

        <RatesTables rates={rates} headingLevel="h3" />
      </div>
    </Container>
  </Section>

  <!-- 7. Khối Tin tức & Thông báo mới nhất -->
  <Section
    id="tin-tuc"
    variant="muted"
    class="scroll-mt-20 border-t border-border-default"
  >
    <Container>
      <div class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 border-b border-border-default pb-3">
          <div>
            <span class="text-xs uppercase font-extrabold tracking-widest text-brand-primary">
              Nhịp sống Quỹ tín dụng
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-ink-base mt-1">
              Tin tức &amp; Thông báo
            </h2>
          </div>
          <a
            data-home-news-link
            href="/tin-tuc/"
            class="inline-flex items-center text-sm font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
          >
            Xem tất cả &rarr;
          </a>
        </div>

        {publishedNews.length === 0 ? (
          <div
            data-home-news-empty
            class="p-8 text-center rounded-xl border border-border-default bg-surface-page"
          >
            <p class="text-ink-muted text-base">{DEFAULT_FALLBACK_TEXT}</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            {publishedNews.slice(0, 3).map((item) => (
              <Card
                title={item.data.title}
                description={item.data.description}
                href={getNewsDetailHref(item.id)}
                badge={getNewsCategoryLabel(item.data.category)}
                date={formatDate(item.data.pubDate)}
                dateTime={formatDateIso(item.data.pubDate)}
              />
            ))}
          </div>
        )}
      </div>
    </Container>
  </Section>

  <script src="../scripts/poc-calc.ts"></script>
</BaseLayout>
