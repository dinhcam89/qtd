---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import StatItem from '../components/ui/StatItem.astro';
import Card from '../components/ui/Card.astro';
import RatesTables from '../components/RatesTables.astro';
import HomeSlider from '../components/HomeSlider.astro';
import { getSite, getRates, getContact } from '../lib/data';
import {
  getPublishedNews,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../lib/news';
import {
  formatAsOf,
  formatDate,
  formatDateIso,
  formatNumber,
  formatCurrency,
  formatText,
} from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';
import { generateQrSvgPath } from '../lib/qr';

const site = await getSite();
const rates = await getRates();
const contact = await getContact();
const publishedNews = await getPublishedNews();
const hasBrandAssets = process.env.QTD_FIXTURES !== '1';

const siteTitle = site.name
  ? `Trang chủ — Quỹ tín dụng nhân dân ${site.name}`
  : 'Trang chủ — Quỹ tín dụng nhân dân';
const siteDescription =
  formatText(site.description) ||
  `Cổng thông tin Quỹ tín dụng nhân dân ${site.name}`;

const maxDepositRate = rates.deposit_rates.reduce((max: number, item) => {
  if (item.rate !== null && item.rate > max) {
    return item.rate;
  }
  return max;
}, 0);

const validDepositOptions = rates.deposit_rates.filter(
  (r) => r.rate !== null && r.rate > 0.5
);

const rawZalo = (contact.zalo || contact.phone || '0915942559').replace(
  /\s+/g,
  ''
);
const zaloHref = /^0\d{8,10}$/.test(rawZalo)
  ? `https://zalo.me/${rawZalo}`
  : 'https://zalo.me/0915942559';
const qrSvgPath = generateQrSvgPath(zaloHref);

/**
 * THUỘC TÍNH CHỌN PHƯƠNG ÁN ẢNH NỀN TRANG CHỦ:
 * Đổi giá trị của ACTIVE_HERO_BG_OPTION thành '1' | '2' | '3' | '4' (hoặc sửa data-active-bg-option bên dưới):
 * - '1': Mái hiên Quê hương & Đèn lồng ấm áp (Phong cách Quán Nhà VCB)
 * - '2': Cánh đồng Lúa chín & Lũy tre làng
 * - '3': Cây đa cổ thụ & Làng quê thanh bình
 * - '4': Đường tỉnh lộ uốn lượn qua cánh đồng lúa & thôn xóm
 */
const ACTIVE_HERO_BG_OPTION: string = '1';
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  transparentHeader={true}
>
  <!-- 1. Hero Section: Bộ 4 Phương án Nền Màu nước Thoáng rộng kiểu Vietcombank & Khối QR Zalo -->
  <section class="relative w-full min-h-[calc(100vh-5.25rem)] md:min-h-[calc(100vh-8.5rem)] flex flex-col justify-center pt-2 pb-24 sm:pt-3 sm:pb-28 lg:pt-3 lg:pb-28 border-b border-emerald-900/10">
    <!-- Lớp nền Bầu trời & Phong cảnh Màu nước bao phủ lên sát đỉnh trang (-top-52), đổi số trong data-active-bg-option="1..4" để chọn ảnh nền -->
    <div
      id="hero-bg-container"
      data-active-bg-option={ACTIVE_HERO_BG_OPTION}
      class="absolute inset-x-0 -top-52 bottom-0 w-full pointer-events-none select-none overflow-hidden bg-gradient-to-b from-[#89ccf2] via-[#cbe8f6] via-48% to-[#eef8f2] z-0"
      aria-hidden="true"
    >
      <!-- Option 1: Mái hiên Quê hương & Đèn lồng ấm áp (Màu nước chuẩn phong cách VCB Quán Nhà) -->
      <div
        data-bg-option-layer="1"
        class:list={[
          'absolute inset-0 w-full h-full transition-opacity duration-500',
          ACTIVE_HERO_BG_OPTION === '1'
            ? 'opacity-100'
            : 'opacity-0 pointer-events-none',
        ]}
      >
        {hasBrandAssets && (
          <img
            src="/images/poc-bg-option1.jpg"
            alt=""
            width="1920"
            height="1080"
            class="w-full h-full object-cover object-bottom"
          />
        )}
        <!-- Lớp hòa trộn bầu trời phía trên giúp Header trong suốt liền mạch -->
        <div class="absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-[#89ccf2] via-[#aedcf6]/70 to-transparent"></div>
        <!-- Hiệu ứng ánh sáng ấm áp tỏa nhẹ quanh mái hiên làng quê góc phải dưới -->
        <div class="absolute bottom-12 right-8 sm:right-24 w-48 h-48 sm:w-64 sm:h-64 rounded-full bg-[radial-gradient(circle,_rgba(254,240,138,0.45)_0%,_rgba(253,224,71,0)_70%)] animate-sunbeam-pulse"></div>
      </div>

      <!-- Option 2: Cánh đồng lúa Bậc thang Mùa vàng & Lũy tre làng -->
      <div
        data-bg-option-layer="2"
        class:list={[
          'absolute inset-0 w-full h-full transition-opacity duration-500',
          ACTIVE_HERO_BG_OPTION === '2'
            ? 'opacity-100'
            : 'opacity-0 pointer-events-none',
        ]}
      >
        {hasBrandAssets && (
          <img
            src="/images/poc-bg-option2.jpg"
            alt=""
            width="1920"
            height="1080"
            class="w-full h-full object-cover object-bottom"
            loading="lazy"
          />
        )}
        <div class="absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-[#89ccf2] via-[#b8e2f8]/70 to-transparent"></div>
        <div class="absolute top-52 right-12 sm:right-28 w-48 h-48 sm:w-64 sm:h-64 rounded-full bg-[radial-gradient(circle,_rgba(254,249,195,0.55)_0%,_rgba(254,240,138,0)_72%)] animate-sunbeam-pulse"></div>
      </div>

      <!-- Option 3: Cây đa Sân đình & Đồng cỏ Nông thôn Thanh bình -->
      <div
        data-bg-option-layer="3"
        class:list={[
          'absolute inset-0 w-full h-full transition-opacity duration-500',
          ACTIVE_HERO_BG_OPTION === '3'
            ? 'opacity-100'
            : 'opacity-0 pointer-events-none',
        ]}
      >
        {hasBrandAssets && (
          <img
            src="/images/poc-bg-option3.jpg"
            alt=""
            width="1920"
            height="1080"
            class="w-full h-full object-cover object-bottom"
            loading="lazy"
          />
        )}
        <div class="absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-[#8acdf3] via-[#bfe5f7]/70 to-transparent"></div>
        <div class="absolute bottom-16 right-12 sm:right-24 w-48 h-48 sm:w-64 sm:h-64 rounded-full bg-[radial-gradient(circle,_rgba(254,240,138,0.4)_0%,_rgba(254,240,138,0)_70%)] animate-sunbeam-pulse"></div>
      </div>

      <!-- Option 4: Đường tỉnh lộ xuyên cánh đồng lúa & nhà cửa thôn xóm cuối đường -->
      <div
        data-bg-option-layer="4"
        class:list={[
          'absolute inset-0 w-full h-full transition-opacity duration-500',
          ACTIVE_HERO_BG_OPTION === '4'
            ? 'opacity-100'
            : 'opacity-0 pointer-events-none',
        ]}
      >
        {hasBrandAssets && (
          <img
            src="/images/poc-bg-option4.jpg"
            alt=""
            width="1920"
            height="1080"
            class="w-full h-full object-cover object-bottom"
            loading="lazy"
          />
        )}
        <div class="absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-[#89ccf2] via-[#bce2f7]/70 to-transparent"></div>
        <div class="absolute bottom-16 inset-x-0 mx-auto w-64 h-48 rounded-full bg-[radial-gradient(circle,_rgba(254,240,138,0.4)_0%,_rgba(254,240,138,0)_70%)] animate-sunbeam-pulse"></div>
      </div>
    </div>

    <!-- Nội dung chính Hero tràn rộng, thoáng đãng và cân đối theo bố cục Vietcombank -->
    <Container class="relative z-10">
      <div
        data-page-content
        class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-6 items-center py-1 sm:py-2 lg:py-2"
      >
        <!-- Cột trái (5 cột): Tinh gọn đúng chuẩn VCB (Lời chào thời gian thực + Thanh tìm kiếm viên thuốc) -->
        <div class="lg:col-span-5 space-y-3.5">
          <h1 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-brand-dark">
            {formatText(site.name)}
          </h1>

          <!-- Icon Mặt trời (Sáng/Chiều) & Mặt trăng (Tối) + Lời chào chuẩn phong cách Vietcombank -->
          <div data-dynamic-greeting class="flex items-center gap-3.5">
            <div
              data-greeting-icon-day
              class="relative w-14 h-14 sm:w-16 sm:h-16 shrink-0 select-none"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="w-full h-full"
              >
                <circle
                  cx="36"
                  cy="26"
                  r="19"
                  fill="#FDE047"
                  fill-opacity="0.35"
                />
                <g stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round">
                  <line x1="36" y1="3" x2="36" y2="7" />
                  <line x1="52.3" y1="9.7" x2="49.4" y2="12.6" />
                  <line x1="59" y1="26" x2="55" y2="26" />
                  <line x1="52.3" y1="42.3" x2="49.4" y2="39.4" />
                  <line x1="19.7" y1="9.7" x2="22.6" y2="12.6" />
                </g>
                <circle cx="36" cy="26" r="13" fill="#FACC15" />
                <circle cx="34" cy="24" r="10" fill="#FDE047" />
                <path
                  d="M14 48H42C46.9706 48 51 43.9706 51 39C51 34.3429 47.4608 30.5123 42.9289 30.0471C41.3666 24.8195 36.5204 21 30.8 21C23.7308 21 18 26.7308 18 33.8C18 34.1297 18.0125 34.4565 18.0369 34.7799C14.6119 35.6054 12 38.6897 12 42.4C12 45.4928 14.5072 48 17.6 48H14Z"
                  fill="#FFFFFF"
                />
              </svg>
            </div>

            <div
              data-greeting-icon-night
              class="hidden relative w-14 h-14 sm:w-16 sm:h-16 shrink-0 select-none"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="w-full h-full"
              >
                <circle cx="18" cy="18" r="1.8" fill="#FBBF24" />
                <circle cx="52" cy="14" r="1.5" fill="#FDE047" />
                <path
                  d="M49 24L50.2 26.8L53 28L50.2 29.2L49 32L47.8 29.2L45 28L47.8 26.8L49 24Z"
                  fill="#FDE047"
                />
                <path
                  d="M41.5 12C34.2 13.6 28.8 20.1 28.8 27.9C28.8 36.9 36.1 44.2 45.1 44.2C48.7 44.2 52 43 54.7 41C51.6 46.5 45.7 50.2 38.9 50.2C28.9 50.2 20.8 42.1 20.8 32.1C20.8 22.6 28.1 14.8 37.4 14.1C38.8 12.9 40.1 12.3 41.5 12Z"
                  fill="#F59E0B"
                />
                <path
                  d="M12 50H36C40.4183 50 44 46.4183 44 42C44 37.8934 40.9067 34.5112 36.9189 34.0519C35.5122 29.6879 31.4161 26.5 26.5 26.5C20.4249 26.5 15.5 31.4249 15.5 37.5C15.5 37.8404 15.5155 38.1772 15.5458 38.5096C12.3999 39.2216 10 42.0329 10 45.4C10 47.9405 12.0595 50 14.6 50H12Z"
                  fill="#FFFFFF"
                />
              </svg>
            </div>

            <div class="space-y-0.5">
              <span
                class="block text-2xl sm:text-3xl font-extrabold text-ink-base tracking-tight"
                data-greeting-title
              >
                Chào buổi sáng
              </span>
              <p
                class="text-xs sm:text-sm text-ink-base font-medium"
                data-greeting-subtitle
              >
                Quý khách hàng đang tìm kiếm gì hôm nay?
              </p>
            </div>
          </div>

          <!-- Thanh tìm kiếm nhanh hình viên thuốc tinh gọn (Vietcombank Quick Search Pill) -->
          <div class="max-w-md space-y-2.5">
            <div class="relative flex items-center rounded-full bg-white shadow-md border border-white/90 px-4 py-3 focus-within:ring-2 focus-within:ring-brand-primary transition-shadow">
              <span class="pr-3 text-ink-muted" aria-hidden="true">
                <svg
                  class="w-4 h-4 sm:w-5 sm:h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  ></path>
                </svg>
              </span>
              <input
                type="text"
                aria-label="Tìm kiếm sản phẩm, dịch vụ"
                placeholder="Cho vay cầm cố sổ tiết kiệm, chuyển tiền 24/7, rút tiền..."
                class="w-full bg-transparent text-xs sm:text-sm text-ink-base placeholder:text-ink-muted focus:outline-hidden font-medium"
              />
            </div>

            <!-- Gợi ý nghiệp vụ nhanh ngay dưới thanh tìm kiếm -->
            <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
              <a
                href="/san-pham#cho-vay"
                class="inline-flex items-center px-3 py-1 rounded-full bg-white/85 hover:bg-white text-brand-dark text-xs font-semibold shadow-2xs border border-emerald-900/10 transition-colors"
              >
                Cho vay cầm cố sổ tiết kiệm
              </a>
              <a
                href="/san-pham#dich-vu-thanh-toan"
                class="inline-flex items-center px-3 py-1 rounded-full bg-white/85 hover:bg-white text-brand-dark text-xs font-semibold shadow-2xs border border-emerald-900/10 transition-colors"
              >
                Chuyển tiền 24/7
              </a>
              <a
                href="/san-pham#dich-vu-thanh-toan"
                class="inline-flex items-center px-3 py-1 rounded-full bg-white/85 hover:bg-white text-brand-dark text-xs font-semibold shadow-2xs border border-emerald-900/10 transition-colors"
              >
                Rút tiền
              </a>
            </div>
          </div>
        </div>

        <!-- Cột phải (7 cột): Khối QR Zalo (có Logo PCF & Tên Quỹ ở giữa) + Bộ 2 thẻ xếp lớp sinh động -->
        <div class="lg:col-span-7">
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-5 sm:gap-6 lg:gap-7">
            <!-- Cụm 1: Mã QR Zalo vuông trắng tinh gọn + Mũi tên cong kiểu VCB ("Quét Zalo liên hệ") -->
            <div class="flex flex-col items-center shrink-0 sm:-mt-6">
              <div class="mb-1.5 flex flex-col items-center text-center">
                <span class="text-xs font-extrabold text-brand-dark tracking-tight italic">
                  Quét Zalo liên hệ
                </span>
                <svg
                  class="w-16 h-6 text-brand-primary"
                  viewBox="0 0 80 28"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M64 24 C54 6, 32 4, 16 14"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M22 8 L15 15 L24 17"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <a
                href={zaloHref}
                target="_blank"
                rel="noopener noreferrer"
                title={`Quét mã QR Zalo liên hệ ${formatText(site.short_name || 'QTD Vạn Trạch')}`}
                aria-label={`Quét mã QR Zalo liên hệ ${formatText(site.short_name || 'QTD Vạn Trạch')}`}
                class="animate-qr-float group relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl bg-white p-2 shadow-xl border-2 border-white hover:border-brand-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border-focus"
              >
                <div class="relative w-full h-full rounded-lg bg-white overflow-hidden">
                  <!-- Tia quét hoạt ảnh tinh tế -->
                  <div
                    class="animate-qr-scan absolute inset-x-1 top-1 h-1 rounded-full bg-gradient-to-r from-transparent via-[#00a85a] to-transparent pointer-events-none z-20"
                    aria-hidden="true"
                  ></div>

                  <!-- Mã QR Zalo chuẩn ISO/IEC 18004 sắc nét -->
                  <svg
                    viewBox="0 0 31 31"
                    shape-rendering="crispEdges"
                    class="w-full h-full text-slate-900"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <rect width="31" height="31" fill="#ffffff" />
                    <path d={qrSvgPath} />
                  </svg>

                  <!-- Tâm QR ở giữa: Logo PCF tách nền & Tên Quỹ -->
                  <div
                    aria-hidden="true"
                    class="absolute inset-0 flex items-center justify-center pointer-events-none z-10"
                  >
                    <div class="bg-white rounded-md px-1 py-0.5 shadow-xs border border-emerald-700/30 flex flex-col items-center justify-center">
                      {hasBrandAssets && (
                        <img
                          src="/images/logo.png"
                          alt=""
                          width="22"
                          height="22"
                          decoding="async"
                          class="w-5 h-5 sm:w-5.5 sm:h-5.5 object-contain"
                        />
                      )}
                      <span class="text-[5px] sm:text-[5.5px] font-extrabold text-brand-primary uppercase leading-none tracking-tighter mt-0.5 whitespace-nowrap">
                        {formatText(site.short_name || 'QTD Vạn Trạch')}
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </div>

            <!-- Cụm 2: Bộ 2 thẻ xếp lớp (Thẻ Sổ Tiết Kiệm Thành Viên ở trước lắc nhẹ + Thẻ Co-opBank NAPAS lấp ló phía sau) -->
            <div class="relative w-full max-w-md pb-5 sm:pb-6 sm:pr-3">
              <!-- Thẻ 1: Sổ tiết kiệm thành viên uy tín (có hiệu ứng lắc nhẹ định kỳ vài giây một lần) -->
              <div class="relative z-10 rounded-3xl bg-[#014d27] bg-gradient-to-br from-[#006d35] via-[#015a30] to-[#014d27] p-4 sm:p-5 text-white shadow-2xl border-2 border-white/40 animate-card-periodic-sway transition-transform duration-300">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ffd100]"></span>
                    <span class="text-xs uppercase font-extrabold tracking-wider text-white">
                      Sổ Tiết Kiệm Thành Viên
                    </span>
                  </div>
                </div>

                <div class="my-3.5 sm:my-4 space-y-1">
                  <div class="text-xs text-white/95 font-medium">
                    Lãi suất tiết kiệm hấp dẫn:
                  </div>
                  <div class="text-3xl sm:text-4xl font-extrabold text-white flex items-baseline gap-1">
                    {maxDepositRate > 0
                      ? `${maxDepositRate.toString().replace('.', ',')}%`
                      : DEFAULT_FALLBACK_TEXT}
                    {maxDepositRate > 0 && (
                      <span class="text-sm font-semibold text-white">/năm</span>
                    )}
                  </div>
                  <div class="text-xs text-white/90 pt-1">
                    Kỳ hạn linh hoạt từ 01 đến 36 tháng &bull; An toàn tuyệt đối
                  </div>
                </div>

                <div class="flex items-center justify-between text-xs border-t border-white/25 pt-3">
                  <span class="font-semibold text-white">
                    {formatText(site.short_name || site.name)}
                  </span>
                  <span class="text-white/90">
                    {contact.phone
                      ? `Hotline: ${contact.phone}`
                      : 'Tổ chức BHTG'}
                  </span>
                </div>
              </div>

              <!-- Thẻ 2: Thẻ Chip Co-opBank Napas lấp ló phía sau -->
              <div
                class="hidden sm:block absolute -top-4 right-0 w-4/5 rounded-3xl bg-[#0f4c5c] p-4 text-white shadow-xl transform rotate-6 border border-white/30 -z-0"
                aria-hidden="true"
              >
                <div class="flex justify-between items-center text-[11px] font-bold text-white">
                  <span>Co-opBank NAPAS</span>
                  <span>Chuyển tiền 24/7 &bull; Rút tiền</span>
                </div>
                <div class="h-12"></div>
              </div>

              <!-- Huy hiệu BHTG DIV nổi bật đè góc -->
              <div class="relative sm:absolute mt-3 sm:mt-0 sm:bottom-0 sm:left-0 z-20 bg-white rounded-2xl p-2 sm:p-2.5 shadow-lg border border-emerald-200 flex items-center gap-2.5 max-w-xs">
                {hasBrandAssets && (
                  <img
                    src="/images/chung-nhan-bhtg-vn.png"
                    alt="Chứng nhận Bảo hiểm tiền gửi Việt Nam"
                    width="70"
                    height="48"
                    decoding="async"
                    class="h-8 sm:h-10 w-auto object-contain shrink-0"
                  />
                )}
                <div class="text-left">
                  <div class="text-xs font-bold text-ink-base leading-tight">
                    Bảo Hiểm Tiền Gửi VN
                  </div>
                  <div class="text-[11px] text-brand-primary font-semibold">
                    Tổ chức đã tham gia BHTG
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 2. Thanh Tiện Ích Dock Nổi Hình Viên Thuốc 5 Mục Cân Đối (Vietcombank Floating Pill Dock) -->
  <section
    aria-label="Lối tắt tiện ích nhanh"
    class="relative z-30 -mt-20 sm:-mt-24 lg:-mt-[6.25rem] pb-8 sm:pb-10"
  >
    <Container>
      <div class="rounded-3xl sm:rounded-full bg-white shadow-lg border border-emerald-200/80 p-2.5 sm:p-3 lg:py-3 lg:px-6">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2 sm:gap-4 items-center">
          <a
            href="#lai-suat"
