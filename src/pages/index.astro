---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Trang chủ — Quỹ tín dụng nhân dân [TÊN QUỸ]"
  description="Website thông tin chính thức của Quỹ tín dụng nhân dân [TÊN QUỸ]"
>
  <div class="space-y-8">
    <section class="py-6 border-b border-gray-200">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl mb-4">
        Quỹ tín dụng nhân dân [TÊN QUỸ]
      </h1>
      <p class="text-lg text-gray-700 max-w-3xl">
        Chào mừng quý thành viên và khách hàng đến với website thông tin chính
        thức của Quỹ tín dụng nhân dân.
      </p>
    </section>

    <section class="py-4">
      <div class="rounded-lg bg-blue-50 border border-blue-200 p-6">
        <h2 class="text-xl font-semibold text-blue-900 mb-2">Thông báo</h2>
        <p class="text-blue-800">
          Hệ thống đang trong quá trình hoàn thiện nền tảng kỹ thuật. Mọi số
          liệu và thông tin chính thức sẽ được cập nhật sau khi được phê duyệt.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
