---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import LinkButton from '../components/ui/LinkButton.astro';
import StatItem from '../components/ui/StatItem.astro';
import Card from '../components/ui/Card.astro';
import RatesTables from '../components/RatesTables.astro';
import { getSite, getRates } from '../lib/data';
import {
  getPublishedNews,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../lib/news';
import {
  formatAsOf,
  formatDate,
  formatDateIso,
  formatNumber,
  formatCurrency,
  formatText,
} from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const site = await getSite();
const rates = await getRates();
const publishedNews = await getPublishedNews();

const siteTitle = site.name
  ? `Trang chủ — Quỹ tín dụng nhân dân ${site.name}`
  : 'Trang chủ — Quỹ tín dụng nhân dân';
const siteDescription =
  formatText(site.description) ||
  `Cổng thông tin Quỹ tín dụng nhân dân ${site.name}`;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <!-- 1. Hero Section -->
  <Section
    variant="default"
    class="border-b border-border-default pt-8 pb-12 sm:pt-12 sm:pb-16"
  >
    <Container>
      <div class="max-w-3xl space-y-5">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-primary tracking-tight leading-tight">
          {formatText(site.name)}
        </h1>
        <p class="text-lg sm:text-xl text-ink-muted leading-relaxed">
          {formatText(site.description)}
        </p>
        <div
          data-hero-actions
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2"
        >
          <LinkButton
            data-hero-btn
            href="#lai-suat"
            variant="primary"
            class="w-full sm:w-auto text-center"
          >
            Xem biểu lãi suất
          </LinkButton>
          <LinkButton
            data-hero-btn
            href="/lien-he"
            variant="secondary"
            class="w-full sm:w-auto text-center"
          >
            Thông tin liên hệ
          </LinkButton>
        </div>
      </div>
    </Container>
  </Section>

  <!-- 2. Khối Số liệu quy mô (#quy-mo) -->
  <Section id="quy-mo" data-scale-section variant="muted" class="scroll-mt-20">
    <Container>
      <div data-page-content class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h2 class="text-2xl font-bold text-ink-base">Quy mô hoạt động</h2>
          <p class="text-sm text-ink-muted">
            {site.stats.as_of
              ? `Số liệu ${formatAsOf(site.stats.as_of)}`
              : `Số liệu: ${DEFAULT_FALLBACK_TEXT}`}
          </p>
        </div>

        <!-- Lưới thẻ quy mô: 1 cột dưới 480px, 2 cột từ 480px đến dưới lg, 4 cột từ lg -->
        <div
          data-scale-grid
          class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 items-stretch"
        >
          <StatItem
            label="Tổng thành viên"
            value={
              site.stats.members_count != null
                ? formatNumber(site.stats.members_count)
                : null
            }
            unit="thành viên"
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Vốn điều lệ"
            value={
              site.stats.charter_capital != null
                ? formatCurrency(site.stats.charter_capital)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Tổng tài sản"
            value={
              site.stats.total_assets != null
                ? formatCurrency(site.stats.total_assets)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />

          <StatItem
            label="Dư nợ cho vay"
            value={
              site.stats.total_loans != null
                ? formatCurrency(site.stats.total_loans)
                : null
            }
            asOf={site.stats.as_of ? formatDate(site.stats.as_of) : null}
          />
        </div>
      </div>
    </Container>
  </Section>

  <!-- 3. Khối Lãi suất tóm tắt (#lai-suat) -->
  <Section
    id="lai-suat"
    data-rates-section
    variant="default"
    class="scroll-mt-20"
  >
    <Container>
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-ink-base">
            Biểu lãi suất tham khảo
          </h2>
          <p class="text-sm text-ink-muted mt-1">
            {rates.effective_from
              ? `Áp dụng từ ngày ${formatDate(rates.effective_from)}`
              : `Thời điểm áp dụng: ${DEFAULT_FALLBACK_TEXT}`}
          </p>
        </div>

        <RatesTables rates={rates} headingLevel="h3" />
      </div>
    </Container>
  </Section>

  <!-- 4. Khối Tin mới (Ẩn hoàn toàn nếu chưa có bài công khai, đã lọc draft: true) -->
  {publishedNews.length > 0 && (
    <Section id="tin-tuc" variant="muted" class="scroll-mt-20">
      <Container>
        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-ink-base">Tin tức & Thông báo</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
            {publishedNews.slice(0, 3).map((item) => (
              <Card
                title={item.data.title}
                description={item.data.description}
                href={getNewsDetailHref(item.id)}
                badge={getNewsCategoryLabel(item.data.category)}
                date={formatDate(item.data.pubDate)}
                dateTime={formatDateIso(item.data.pubDate)}
              />
            ))}
          </div>
          <p>
            <a
              data-home-news-link
              href="/tin-tuc/"
              class="inline-flex items-center min-h-[44px] font-medium text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
            >
              Xem tất cả tin tức &rarr;
            </a>
          </p>
        </div>
      </Container>
    </Section>
  )}

  <!-- 5. Khối Bảo hiểm tiền gửi Việt Nam (Chứng nhận bảo vệ người gửi tiền) -->
  <Section
    variant="brand-subtle"
    class="border-t border-border-default py-10 sm:py-14"
  >
    <Container>
      <div class="rounded-2xl border border-brand-primary/20 bg-surface-page p-6 sm:p-8 shadow-xs flex flex-col md:flex-row items-center justify-between gap-6 sm:gap-8">
        <div class="flex flex-col sm:flex-row items-center sm:items-start md:items-center gap-5 sm:gap-6 text-center sm:text-left">
          <!-- Huy hiệu chứng nhận chính thức BHTG Việt Nam (DIV) -->
          <div class="bg-white p-2.5 rounded-xl border border-border-default shadow-xs shrink-0">
            <img
              src="/images/bhtg-chung-nhan.png"
              alt="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam (DIV)"
              width="180"
              height="110"
              class="h-20 sm:h-24 w-auto object-contain"
              loading="lazy"
            />
          </div>
          <div class="space-y-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-primary/10 text-brand-primary text-xs font-semibold uppercase tracking-wider">
              Chứng nhận an toàn tài chính
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-ink-base">
              Tổ chức tham gia Bảo hiểm Tiền gửi Việt Nam
            </h2>
            <p class="text-sm sm:text-base text-ink-muted leading-relaxed max-w-2xl">
              Quỹ tín dụng nhân dân {formatText(site.name)} là tổ chức tín dụng
              đã tham gia Bảo hiểm tiền gửi theo quy định của Ngân hàng Nhà nước
              Việt Nam. Mọi khoản tiền gửi tiết kiệm của thành viên và khách
              hàng đều được bảo vệ và chi trả theo đúng quy định của Luật Bảo
              hiểm tiền gửi.
            </p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-2.5 w-full md:w-auto shrink-0 text-center sm:text-left md:text-center">
          <div class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 text-sm font-semibold">
            <svg
              class="w-4 h-4 text-emerald-600 shrink-0"
              fill="currentColor"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            Bảo vệ quyền lợi 100%
          </div>
          <span class="text-xs text-ink-subtle">
            Bảo hiểm Tiền gửi Việt Nam (DIV)
          </span>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
