---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import StatItem from '../components/ui/StatItem.astro';
import { getSite } from '../lib/data';
import {
  formatAsOf,
  formatDate,
  formatNumber,
  formatCurrency,
  formatText,
} from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const site = await getSite();
const stats = site.stats;

const pageTitle = `Quy mô hoạt động — Quỹ tín dụng nhân dân ${formatText(site.name)}`;
const pageDescription = `Số liệu quy mô hoạt động tổng hợp của Quỹ tín dụng nhân dân ${formatText(site.name)}: thành viên, vốn điều lệ, tổng tài sản, huy động vốn và dư nợ cho vay.`;

const asOf = stats.as_of ? formatDate(stats.as_of) : null;

interface StatCardConfig {
  label: string;
  value: string | null;
  unit?: string;
}

const statCards: StatCardConfig[] = [
  {
    label: 'Tổng thành viên',
    value:
      stats.members_count != null ? formatNumber(stats.members_count) : null,
    unit: 'thành viên',
  },
  {
    label: 'Vốn điều lệ',
    value:
      stats.charter_capital != null
        ? formatCurrency(stats.charter_capital)
        : null,
  },
  {
    label: 'Tổng tài sản',
    value:
      stats.total_assets != null ? formatCurrency(stats.total_assets) : null,
  },
  {
    label: 'Tiền gửi huy động',
    value:
      stats.total_deposits != null
        ? formatCurrency(stats.total_deposits)
        : null,
  },
  {
    label: 'Dư nợ cho vay',
    value: stats.total_loans != null ? formatCurrency(stats.total_loans) : null,
  },
];

// Dùng lg:grid-cols-3 khi có 5 hoặc 6 thẻ để không để thẻ lẻ ở hàng 2, trang chủ giữ 4 cột
const gridLgCols =
  statCards.length === 5 || statCards.length === 6
    ? 'lg:grid-cols-3'
    : 'lg:grid-cols-4';
const hasBrandAssets = process.env.QTD_FIXTURES !== '1';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader
    title="Quy mô hoạt động"
    description="Các số liệu tổng hợp về quy mô hoạt động của Quỹ."
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Giới thiệu', href: '/gioi-thieu' },
      { label: 'Quy mô' },
    ]}
  >
    <p class="mt-2 text-sm text-ink-muted font-medium">
      {stats.as_of
        ? `Số liệu ${formatAsOf(stats.as_of)}`
        : `Số liệu: ${DEFAULT_FALLBACK_TEXT}`}
    </p>
  </PageHeader>

  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="space-y-10">
        <!-- Lưới thẻ quy mô: 1 cột dưới 480px, 2 cột từ 480px đến dưới lg, 3 cột từ lg khi có 5 thẻ -->
        <div
          class:list={[
            'grid grid-cols-1 min-[480px]:grid-cols-2 gap-4 sm:gap-6 items-stretch',
            gridLgCols,
          ]}
        >
          {statCards.map((card) => (
            <StatItem
              label={card.label}
              value={card.value}
              unit={card.unit}
              asOf={asOf}
              class="rounded-2xl border-emerald-200/80 shadow-xs hover:border-brand-primary transition-colors"
            />
          ))}
        </div>

        <!-- Khối Cam kết bảo vệ quyền lợi thành viên & Bảo hiểm tiền gửi Việt Nam (DIV) -->
        <div class="rounded-3xl bg-surface-brand-subtle border border-emerald-200/80 p-6 sm:p-8 lg:p-10 shadow-xs flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
          <div class="space-y-2.5 max-w-2xl">
            <span class="inline-block text-xs uppercase font-extrabold tracking-widest text-brand-dark bg-emerald-100 px-3 py-1 rounded-full border border-emerald-300">
              Bảo chứng an toàn tiền gửi
            </span>
            <h2 class="text-xl sm:text-2xl font-bold text-ink-base">
              Cam kết bảo vệ quyền lợi thành viên &amp; Bảo hiểm tiền gửi Việt
              Nam
            </h2>
            <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
              Quỹ hoạt động theo nguyên tắc hợp tác, tự nguyện, tương trợ giữa
              các thành viên và là tổ chức tham gia Bảo hiểm tiền gửi Việt Nam
              (DIV). Quyền và lợi ích hợp pháp của người gửi tiền luôn được bảo
              vệ theo đúng quy định pháp luật.
            </p>
          </div>

          <div class="flex items-center gap-4 bg-white rounded-2xl p-4 sm:px-6 border border-emerald-200/80 shadow-2xs shrink-0">
            {hasBrandAssets && (
              <a
                href="https://div.gov.vn"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border-focus rounded shrink-0"
                title="Chứng nhận Bảo hiểm tiền gửi Việt Nam (DIV)"
                aria-label="Chứng nhận Bảo hiểm tiền gửi Việt Nam"
              >
                <img
                  src="/images/chung-nhan-bhtg-vn.png"
                  alt="Chứng nhận tổ chức đã tham gia Bảo hiểm tiền gửi Việt Nam"
                  width="160"
                  height="110"
                  class="h-16 sm:h-20 w-auto object-contain block"
                  loading="lazy"
                />
              </a>
            )}
            <div class="text-xs sm:text-sm text-ink-muted max-w-xs leading-relaxed">
              <strong class="text-ink-base block font-bold">
                Tổ chức tham gia BHTG
              </strong>
              Được cấp Chứng nhận tham gia Bảo hiểm tiền gửi theo quy định của
              Ngân hàng Nhà nước và DIV.
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
