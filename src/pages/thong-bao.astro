---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { getSite, getSchedule } from '../lib/data';
import { sortHolidays } from '../lib/schedule';
import { getPublishedNews, getNewsDetailHref } from '../lib/news';
import { formatText, formatDate, formatDateIso } from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const LATEST_NOTICE_COUNT = 5;

const site = await getSite();
const schedule = await getSchedule();
const holidays = sortHolidays(schedule.holidays);
const notices = (await getPublishedNews())
  .filter((entry) => entry.data.category === 'thong-bao')
  .slice(0, LATEST_NOTICE_COUNT);

const siteName = formatText(site.name);
const pageTitle = `Thông báo và lịch làm việc — Quỹ tín dụng nhân dân ${siteName}`;
const pageDescription = `Lịch làm việc thường xuyên, các kỳ nghỉ và thông báo mới nhất của Quỹ tín dụng nhân dân ${siteName}.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader
    title="Thông báo và lịch làm việc"
    description="Lịch làm việc thường xuyên, các kỳ nghỉ và thông báo mới nhất của Quỹ."
    breadcrumb={[{ label: 'Trang chủ', href: '/' }, { label: 'Thông báo' }]}
  />

  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="space-y-12">
        <div data-regular-schedule class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-brand-primary border-b border-border-default pb-2">
            Lịch làm việc thường xuyên
          </h2>
          <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
            <div class="p-5 sm:p-6 rounded-2xl border border-emerald-200/80 bg-surface-brand-subtle shadow-2xs">
              <dt class="text-sm font-semibold text-ink-muted">
                Ngày làm việc
              </dt>
              <dd
                data-field="working-days"
                class="mt-1.5 text-base sm:text-lg font-bold text-ink-base whitespace-pre-line"
              >
                {formatText(schedule.working_days)}
              </dd>
            </div>
            <div class="p-5 sm:p-6 rounded-2xl border border-emerald-200/80 bg-surface-brand-subtle shadow-2xs">
              <dt class="text-sm font-semibold text-ink-muted">Buổi sáng</dt>
              <dd
                data-field="morning"
                class="mt-1.5 text-base sm:text-lg font-bold text-brand-primary"
              >
                {formatText(schedule.morning_hours)}
              </dd>
            </div>
            <div class="p-5 sm:p-6 rounded-2xl border border-emerald-200/80 bg-surface-brand-subtle shadow-2xs">
              <dt class="text-sm font-semibold text-ink-muted">Buổi chiều</dt>
              <dd
                data-field="afternoon"
                class="mt-1.5 text-base sm:text-lg font-bold text-brand-primary"
              >
                {formatText(schedule.afternoon_hours)}
              </dd>
            </div>
          </dl>
          {schedule.notes && (
            <p data-field="notes" class="text-base text-ink-muted">
              <span class="font-semibold text-ink-base">Lưu ý:</span>{' '}
              {formatText(schedule.notes)}
            </p>
          )}
        </div>

        <div data-holidays class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-brand-primary border-b border-border-default pb-2">
            Các kỳ nghỉ
          </h2>
          {holidays.length === 0 ? (
            <p data-holidays-empty class="text-ink-muted">
              {DEFAULT_FALLBACK_TEXT}
            </p>
          ) : (
            <ul class="grid grid-cols-1 gap-4">
              {holidays.map((holiday) => (
                <li
                  data-holiday-item
                  class="p-5 sm:p-6 rounded-2xl border border-emerald-200/80 bg-surface-page shadow-xs"
                >
                  <h3
                    data-holiday-title
                    class="text-lg font-bold text-brand-primary break-words"
                  >
                    {formatText(holiday.title)}
                  </h3>
                  <dl class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div>
                      <dt class="text-sm font-medium text-ink-muted">
                        Từ ngày
                      </dt>
                      <dd
                        data-field="start"
                        class="text-ink-base font-semibold"
                      >
                        {formatDate(holiday.start_date)}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-sm font-medium text-ink-muted">
                        Đến ngày
                      </dt>
                      <dd data-field="end" class="text-ink-base font-semibold">
                        {formatDate(holiday.end_date)}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-sm font-medium text-ink-muted">
                        Ngày làm việc trở lại
                      </dt>
                      <dd
                        data-field="return"
                        class="text-brand-primary font-bold"
                      >
                        {formatDate(holiday.return_date)}
                      </dd>
                    </div>
                  </dl>
                  {holiday.note && (
                    <p class="mt-3 text-sm text-ink-muted">
                      {formatText(holiday.note)}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>

        <div data-latest-notices class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-brand-primary border-b border-border-default pb-2">
            Thông báo mới nhất
          </h2>
          {notices.length === 0 ? (
            <div
              data-notices-empty
              class="p-8 text-center rounded-2xl border border-emerald-200/80 bg-surface-brand-subtle"
            >
              <p class="text-ink-muted text-base sm:text-lg">
                {DEFAULT_FALLBACK_TEXT}
              </p>
            </div>
          ) : (
            <ul class="divide-y divide-border-default border border-emerald-200/80 rounded-2xl overflow-hidden bg-surface-page shadow-xs">
              {notices.map((entry) => (
                <li
                  data-notice-item
                  class="p-4 sm:p-5 hover:bg-surface-brand-subtle/60 transition-colors"
                >
                  <a
                    href={getNewsDetailHref(entry.id)}
                    class="font-semibold text-brand-primary hover:underline break-words focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
                  >
                    {entry.data.title}
                  </a>
                  <p class="mt-1 text-sm text-ink-muted">
                    <time datetime={formatDateIso(entry.data.pubDate)}>
                      {formatDate(entry.data.pubDate)}
                    </time>
                  </p>
                </li>
              ))}
            </ul>
          )}
          <p>
            <a
              data-view-all
              href="/tin-tuc/"
              class="inline-flex items-center min-h-[44px] font-semibold text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
            >
              Xem tất cả &rarr;
            </a>
          </p>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
