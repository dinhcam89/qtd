---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Card from '../components/ui/Card.astro';
import { getSite, getPageEntry } from '../lib/data';
import { formatText, formatDate } from '../lib/format';
import { render } from 'astro:content';

const site = await getSite();
const pageEntry = await getPageEntry('gioi-thieu');
const suMenhEntry = await getPageEntry('su-menh');

const { Content: GioiThieuContent } = await render(pageEntry);
const { Content: SuMenhContent } = await render(suMenhEntry);

const pageTitle = `Giới thiệu — Quỹ tín dụng nhân dân ${formatText(site.name)}`;
const pageDescription = pageEntry.data.description;
const hasBrandAssets = process.env.QTD_FIXTURES !== '1';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader
    title="Giới thiệu chung"
    description={pageEntry.data.description}
    breadcrumb={[{ label: 'Trang chủ', href: '/' }, { label: 'Giới thiệu' }]}
  >
    <p class="mt-2 text-sm text-ink-subtle font-medium">
      Cập nhật: {formatDate(pageEntry.data.updated)}
    </p>
  </PageHeader>

  <!-- Thông tin pháp lý & tôn chỉ hoạt động -->
  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cột chính: Nội dung giới thiệu -->
        <div class="lg:col-span-2 space-y-6">
          <div class="content-body">
            <GioiThieuContent />
          </div>

          <!-- Khối điều hướng trang con liên quan -->
          <div class="pt-8 border-t border-border-default">
            <h2 class="text-xl sm:text-2xl font-bold text-brand-primary mb-4">
              Tìm hiểu thêm về Quỹ
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Card
                title="Quy mô hoạt động"
                description="Các số liệu tổng hợp về thành viên, vốn điều lệ, tổng tài sản và dư nợ của Quỹ."
                href="/quy-mo"
              />
              <Card
                title="Quy chế và văn bản"
                description="Điều lệ, quy chế hoạt động và các biểu mẫu của Quỹ để xem và tải xuống."
                href="/quy-che"
              />
              <Card
                title="Tin tức"
                description="Tin tức, thông báo và hoạt động mới nhất của Quỹ."
                href="/tin-tuc"
              />
              <Card
                title="Thông báo"
                description="Lịch làm việc thường xuyên, các kỳ nghỉ và thông báo của Quỹ."
                href="/thong-bao"
              />
            </div>
          </div>
        </div>

        <!-- Cột phụ: Thông tin tóm tắt pháp lý & Bảo hiểm tiền gửi -->
        <div class="space-y-6">
          <div class="p-6 sm:p-8 rounded-3xl bg-surface-brand-subtle border border-emerald-200/80 shadow-xs space-y-5">
            <div class="flex items-center gap-3">
              {hasBrandAssets && (
                <img
                  src="/images/logo-qtdnd-classic.png"
                  alt="Logo Quỹ tín dụng nhân dân"
                  width="48"
                  height="48"
                  class="h-12 w-auto object-contain shrink-0"
                />
              )}
              <div>
                <span class="text-xs font-extrabold uppercase tracking-wider text-brand-dark">
                  Tổ chức tín dụng hợp tác
                </span>
                <h2 class="text-lg font-bold text-brand-primary leading-snug">
                  Thông tin pháp lý
                </h2>
              </div>
            </div>

            <dl class="space-y-3.5 text-sm border-t border-emerald-200/80 pt-4">
              <div>
                <dt class="font-semibold text-ink-base">Tên tổ chức:</dt>
                <dd class="text-ink-muted mt-0.5">{formatText(site.name)}</dd>
              </div>
              {site.short_name && (
                <div>
                  <dt class="font-semibold text-ink-base">Tên viết tắt:</dt>
                  <dd class="text-ink-muted mt-0.5">
                    {formatText(site.short_name)}
                  </dd>
                </div>
              )}
              <div>
                <dt class="font-semibold text-ink-base">
                  Giấy phép hoạt động:
                </dt>
                <dd class="text-ink-muted mt-0.5">
                  {formatText(site.license_number)}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-ink-base">Địa bàn hoạt động:</dt>
                <dd class="text-ink-muted mt-0.5">
                  {formatText(site.operating_area)}
                </dd>
              </div>
            </dl>

            <div class="pt-4 border-t border-emerald-200/80 flex items-center gap-3">
              {hasBrandAssets && (
                <img
                  src="/images/chung-nhan-bhtg-vn.png"
                  alt="Chứng nhận Bảo hiểm tiền gửi Việt Nam"
                  width="80"
                  height="55"
                  class="h-12 w-auto object-contain shrink-0"
                  loading="lazy"
                />
              )}
              <p class="text-xs text-ink-muted leading-relaxed">
                Tổ chức tham gia{' '}
                <strong class="text-ink-base">
                  Bảo hiểm tiền gửi Việt Nam (DIV)
                </strong>
                .
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Sứ mệnh và Tầm nhìn -->
  <Section class="bg-surface-muted border-t border-border-default">
    <Container>
      <div class="max-w-3xl">
        <span class="inline-block text-xs uppercase font-extrabold tracking-widest text-brand-dark bg-emerald-100/80 px-3 py-1 rounded-full border border-emerald-300 mb-2">
          Định hướng phát triển
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-brand-primary mb-4">
          Sứ mệnh &amp; Tầm nhìn
        </h2>
        <div class="content-body">
          <SuMenhContent />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
