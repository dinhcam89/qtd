---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { getSite } from '../../lib/data';
import {
  getPublishedNews,
  getNewsSlug,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../../lib/news';
import { formatText, formatDate, formatDateIso } from '../../lib/format';

export async function getStaticPaths() {
  const news = await getPublishedNews();
  // news sắp mới trước: bài liền trước (cũ hơn) ở chỉ số i + 1, bài sau (mới hơn) ở i - 1
  return news.map((entry, index) => ({
    params: { slug: getNewsSlug(entry.id) },
    props: {
      entry,
      older: news[index + 1] ?? null,
      newer: news[index - 1] ?? null,
    },
  }));
}

const { entry, older, newer } = Astro.props;
const site = await getSite();
const { Content } = await render(entry);

const pageTitle = `${entry.data.title} — Quỹ tín dụng nhân dân ${formatText(site.name)}`;
const categoryLabel = getNewsCategoryLabel(entry.data.category);
const linkClass =
  'flex flex-col justify-center min-h-[44px] p-4 rounded-lg border border-border-default hover:border-brand-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus';
---

<BaseLayout
  title={pageTitle}
  description={entry.data.description}
  type="article"
  publishedTime={entry.data.pubDate}
>
  <PageHeader
    title={entry.data.title}
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Tin tức', href: '/tin-tuc/' },
      { label: entry.data.title },
    ]}
  >
    <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
      <span class="inline-block text-xs font-semibold text-brand-primary bg-surface-brand-subtle px-2.5 py-1 rounded-sm">
        {categoryLabel}
      </span>
      <time datetime={formatDateIso(entry.data.pubDate)}>
        {formatDate(entry.data.pubDate)}
      </time>
    </p>
  </PageHeader>

  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="space-y-10">
        {entry.data.image && (
          <figure>
            <img
              src={entry.data.image.src}
              alt={entry.data.image.alt}
              width="640"
              height="360"
              class="w-full max-w-[640px] h-auto aspect-video object-cover rounded-lg"
            />
          </figure>
        )}

        <div class="content-body">
          <Content />
        </div>

        <nav
          aria-label="Bài viết liền kề"
          data-news-adjacent
          class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-8 border-t border-border-default"
        >
          {older ? (
            <a href={getNewsDetailHref(older.id)} rel="prev" class={linkClass}>
              <span class="text-sm text-ink-muted">Bài trước</span>
              <span class="font-semibold text-ink-base break-words">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a
              href={getNewsDetailHref(newer.id)}
              rel="next"
              class:list={[linkClass, 'sm:text-right']}
            >
              <span class="text-sm text-ink-muted">Bài sau</span>
              <span class="font-semibold text-ink-base break-words">
                {newer.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>

        <p>
          <a
            href="/tin-tuc/"
            class="inline-flex items-center min-h-[44px] font-medium text-brand-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-border-focus rounded"
          >
            &larr; Quay lại danh sách
          </a>
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
