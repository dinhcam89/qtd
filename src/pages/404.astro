---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import LinkButton from '../components/ui/LinkButton.astro';

const hasBrandAssets = process.env.QTD_FIXTURES !== '1';
---

<BaseLayout
  title="404 — Không tìm thấy trang"
  description="Trang bạn yêu cầu không tồn tại hoặc đã được thay đổi địa chỉ liên kết."
  noindex={true}
>
  <Section variant="brand-subtle" class="py-16 sm:py-24">
    <Container>
      <div class="text-center max-w-xl mx-auto p-8 sm:p-12 rounded-3xl bg-surface-page border border-emerald-200/80 shadow-md space-y-6">
        {hasBrandAssets && (
          <img
            src="/images/logo.png"
            alt="Logo Quỹ tín dụng nhân dân"
            width="60"
            height="60"
            class="h-14 w-auto object-contain mx-auto"
          />
        )}
        <span class="inline-block text-xs font-extrabold tracking-widest text-brand-dark bg-emerald-100/80 border border-emerald-300 px-3.5 py-1 rounded-full uppercase">
          Mã lỗi 404
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-primary">
          Không tìm thấy trang
        </h1>
        <p class="text-base text-ink-muted leading-relaxed">
          Trang bạn đang tìm kiếm không tồn tại, đã bị xóa hoặc tạm thời không
          khả dụng.
        </p>
        <div class="pt-2 flex flex-wrap items-center justify-center gap-4">
          <LinkButton href="/" variant="primary">
            Quay về trang chủ
          </LinkButton>
          <LinkButton href="/lien-he" variant="secondary">
            Thông tin liên hệ
          </LinkButton>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
