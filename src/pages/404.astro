---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Container from '../components/ui/Container.astro';
import LinkButton from '../components/ui/LinkButton.astro';
---

<BaseLayout
  title="404 — Không tìm thấy trang"
  description="Trang bạn yêu cầu không tồn tại hoặc đã được thay đổi địa chỉ liên kết."
  noindex={true}
>
  <Section variant="default" class="py-16 sm:py-24">
    <Container data-page-content>
      <div class="text-center max-w-xl mx-auto space-y-6">
        <p class="text-sm font-bold tracking-widest text-brand-primary uppercase">
          Mã lỗi 404
        </p>
        <h1 class="text-3xl sm:text-4xl font-bold text-ink-base">
          Không tìm thấy trang
        </h1>
        <p class="text-base text-ink-muted leading-relaxed">
          Trang bạn đang tìm kiếm không tồn tại, đã bị xóa hoặc tạm thời không
          khả dụng.
        </p>
        <div class="pt-4">
          <LinkButton href="/" variant="primary">
            Quay về trang chủ
          </LinkButton>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
