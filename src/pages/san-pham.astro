---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { getSite, getProducts } from '../lib/data';
import { formatText } from '../lib/format';
import type { ProductItem } from '../lib/schemas/products';

const site = await getSite();
const products = await getProducts();

const pageTitle = `Sản phẩm — Quỹ tín dụng nhân dân ${formatText(site.name)}`;
const pageDescription = `Các sản phẩm cho vay và tiền gửi của Quỹ tín dụng nhân dân ${formatText(site.name)}.`;

interface ProductGroup {
  id: string;
  badge: string;
  title: string;
  subtitle: string;
  items: ProductItem[];
}

const groups: ProductGroup[] = [
  {
    id: 'cho-vay',
    badge: 'Tín dụng thành viên',
    title: 'Sản phẩm cho vay',
    subtitle:
      'Đồng hành nguồn vốn kịp thời phục vụ sản xuất nông nghiệp, kinh doanh dịch vụ và nâng cao chất lượng đời sống thành viên.',
    items: products.loan_products,
  },
  {
    id: 'tien-gui',
    badge: 'An toàn & Sinh lời',
    title: 'Sản phẩm tiền gửi',
    subtitle:
      'Kỳ hạn linh hoạt, lãi suất minh bạch, tiền gửi được bảo vệ theo quy định của Luật Bảo hiểm tiền gửi.',
    items: products.deposit_products,
  },
  ...(products.payment_services && products.payment_services.length > 0
    ? [
        {
          id: 'dich-vu-thanh-toan',
          badge: 'Ngân hàng số hợp tác xã',
          title:
            'Dịch vụ đại lý thanh toán và chuyển đổi số (Phối hợp với Co-opBank)',
          subtitle:
            'Tiện ích chuyển tiền nhanh 24/7, phát hành thẻ chip Co-opBank NAPAS và ứng dụng Co-opBank Mobile Banking.',
          items: products.payment_services,
        },
      ]
    : []),
];

const fields: Array<{ key: keyof ProductItem; label: string }> = [
  { key: 'summary', label: 'Mô tả' },
  { key: 'target_customers', label: 'Đối tượng' },
  { key: 'amount_limit', label: 'Hạn mức' },
  { key: 'term', label: 'Kỳ hạn' },
  { key: 'conditions', label: 'Điều kiện' },
  { key: 'required_documents', label: 'Hồ sơ cần chuẩn bị' },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHeader
    title="Sản phẩm"
    description="Các sản phẩm cho vay và tiền gửi của Quỹ."
    breadcrumb={[{ label: 'Trang chủ', href: '/' }, { label: 'Sản phẩm' }]}
  />

  <Section class="bg-surface-page">
    <Container>
      <div data-page-content class="space-y-12">
        <!-- Thanh điều hướng nhanh danh mục sản phẩm & dịch vụ -->
        <div class="flex flex-wrap items-center justify-between gap-4 p-4 sm:px-6 rounded-3xl bg-surface-brand-subtle border border-emerald-200/80 shadow-2xs">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <span class="text-xs font-extrabold uppercase tracking-wider text-brand-dark px-2">
              Danh mục:
            </span>
            {groups.map((g) => (
              <a
                href={`#${g.id}`}
                class="inline-flex items-center px-4 py-2 rounded-full bg-surface-page hover:bg-emerald-100/80 text-ink-base hover:text-brand-primary border border-emerald-200 text-xs sm:text-sm font-semibold transition-colors shadow-2xs"
              >
                {g.id === 'dich-vu-thanh-toan'
                  ? 'Dịch vụ số Co-opBank'
                  : g.title}
              </a>
            ))}
          </div>
          <a
            href="/lai-suat"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-primary hover:underline px-2"
          >
            Xem biểu lãi suất hiện hành &rarr;
          </a>
        </div>

        <!-- Các nhóm sản phẩm -->
        {groups.map((group) => (
          <section id={group.id} class="space-y-6 scroll-mt-24">
            <div class="border-b border-border-default pb-4 space-y-1.5">
              <span class="inline-block text-xs uppercase font-extrabold tracking-widest text-brand-dark bg-emerald-100/80 px-3 py-1 rounded-full border border-emerald-300">
                {group.badge}
              </span>
              <h2 class="text-2xl sm:text-3xl font-bold text-brand-primary pt-1">
                {group.title}
              </h2>
              <p class="text-sm sm:text-base text-ink-muted max-w-3xl">
                {group.subtitle}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 items-stretch">
              {group.items.map((item, idx) => (
                <article
                  data-product-card
                  class="h-full p-6 sm:p-8 rounded-3xl bg-surface-page border border-emerald-200/80 shadow-xs hover:border-brand-primary transition-colors flex flex-col justify-between space-y-5"
                >
                  <div class="space-y-4">
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex items-center gap-3">
                        <span class="w-10 h-10 rounded-2xl bg-emerald-100 text-brand-dark font-extrabold text-base flex items-center justify-center shrink-0">
                          {idx + 1}
                        </span>
                        <h3 class="text-xl font-bold text-brand-primary leading-snug">
                          {formatText(item.name)}
                        </h3>
                      </div>
                      {group.id === 'dich-vu-thanh-toan' && (
                        <span class="shrink-0 text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-brand-dark border border-emerald-300">
                          Co-opBank
                        </span>
                      )}
                      {group.id === 'tien-gui' && (
                        <span class="shrink-0 text-xs font-bold px-2.5 py-1 rounded-full bg-emerald-100 text-brand-dark border border-emerald-300">
                          Bảo hiểm DIV
                        </span>
                      )}
                    </div>

                    <dl class="space-y-3.5 text-base pt-2 border-t border-border-default">
                      {fields.map((field) => (
                        <div class="grid grid-cols-1 sm:grid-cols-12 gap-1 sm:gap-3">
                          <dt class="sm:col-span-4 font-semibold text-ink-base text-sm sm:text-base">
                            {field.label}
                          </dt>
                          <dd class="sm:col-span-8 text-ink-muted text-sm sm:text-base leading-relaxed">
                            {formatText(item[field.key] as string | null)}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>

                  <div class="pt-4 border-t border-border-default flex items-center justify-between text-xs sm:text-sm">
                    <a
                      href="/lai-suat"
                      class="font-semibold text-brand-primary hover:underline"
                    >
                      Tra cứu lãi suất &rarr;
                    </a>
                    <a
                      href="/lien-he"
                      class="font-semibold text-ink-muted hover:text-brand-primary"
                    >
                      Liên hệ tư vấn tại quầy
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
