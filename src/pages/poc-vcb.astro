              <div class="inline-flex items-center gap-2 text-xs sm:text-sm font-extrabold text-brand-dark">
                <span>{formatText(site.short_name || 'QTDND')}</span>
                <span class="text-ink-muted font-normal">&times;</span>
                <span class="text-brand-primary">Đồng hành Nông thôn</span>
