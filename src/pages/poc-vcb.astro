---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import StatItem from '../components/ui/StatItem.astro';
import Card from '../components/ui/Card.astro';
import RatesTables from '../components/RatesTables.astro';
import HomeSlider from '../components/HomeSlider.astro';
import { getSite, getRates, getContact } from '../lib/data';
import {
  getPublishedNews,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../lib/news';
import {
  formatAsOf,
  formatDate,
  formatDateIso,
  formatNumber,
  formatCurrency,
  formatText,
} from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const site = await getSite();
const rates = await getRates();
const contact = await getContact();
const publishedNews = await getPublishedNews();
const hasBrandAssets = process.env.QTD_FIXTURES !== '1';

const siteTitle = site.name
  ? `POC Giao diện Nông thôn & QR Zalo — Quỹ tín dụng nhân dân ${site.name}`
  : 'POC Giao diện Nông thôn & QR Zalo — Quỹ tín dụng nhân dân';
const siteDescription = `Bản thử nghiệm POC trang chủ Quỹ tín dụng nhân dân ${formatText(site.name)} với hoạt ảnh cánh đồng lúa, đồng hành phát triển kinh tế nông thôn và mã QR Zalo hỗ trợ trực tuyến.`;

const maxDepositRate = rates.deposit_rates.reduce((max: number, item) => {
  if (item.rate !== null && item.rate > max) {
    return item.rate;
  }
  return max;
}, 0);

const validDepositOptions = rates.deposit_rates.filter(
  (r) => r.rate !== null && r.rate > 0.5
);

const rawZalo = (contact.zalo || contact.phone || '0915942559').replace(
  /\s+/g,
  ''
);
const zaloHref = /^0\d{8,10}$/.test(rawZalo)
  ? `https://zalo.me/${rawZalo}`
  : 'https://zalo.me/0915942559';
const zaloDisplay = contact.zalo || contact.phone || '0915 942 559';
---

<BaseLayout
  title={siteTitle}
  description={siteDescription}
  transparentHeader={true}
>
  <!-- 1. Hero Section POC: Hoạt ảnh Cánh đồng lúa Nông thôn Việt Nam & Khối QR Zalo kiểu Vietcombank -->
  <section class="relative w-full pt-6 pb-24 sm:pt-10 sm:pb-28 lg:pt-12 lg:pb-36 border-b border-emerald-900/10">
    <!-- Lớp nền Bầu trời & Cánh đồng lúa có hoạt ảnh mượt 60fps bao phủ lên sát đỉnh trang (-top-52) -->
    <div
      class="absolute inset-x-0 -top-52 bottom-0 w-full pointer-events-none select-none overflow-hidden bg-gradient-to-b from-[#92d3f5] via-[#c5ebe9] via-42% to-[#eef8ec] z-0"
      aria-hidden="true"
    >
      <!-- Quầng sáng bầu trời ban mai -->
      <div class="absolute inset-x-0 top-0 h-64 bg-[radial-gradient(ellipse_at_top,_rgba(255,255,255,0.6)_0%,_rgba(255,255,255,0)_72%)]"></div>

      <!-- Mặt trời ban mai & Tia nắng ấm áp chuyển động nhẹ (animate-sunbeam-pulse) -->
      <div class="absolute top-48 right-6 sm:right-20 w-40 h-40 sm:w-56 sm:h-56 rounded-full bg-[radial-gradient(circle,_rgba(253,224,71,0.58)_0%,_rgba(254,240,138,0.22)_45%,_rgba(253,224,71,0)_72%)] animate-sunbeam-pulse"></div>
      <div class="absolute top-58 right-16 sm:right-32 w-14 h-14 sm:w-20 sm:h-20 rounded-full bg-[#fef08a] border-2 border-white/70 shadow-md"></div>

      <!-- Toàn cảnh Cánh đồng lúa Nông thôn, Dòng vốn xanh & Mái nhà Hợp tác xã có hoạt ảnh -->
      <svg
        class="absolute bottom-0 inset-x-0 w-full h-[68%] sm:h-[75%] object-cover"
        preserveAspectRatio="none"
        viewBox="0 0 1440 460"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Tầng 1: Dãy núi xa mờ thanh bình -->
        <path
          d="M0,175 Q320,85 690,155 T1440,105 L1440,460 L0,460 Z"
          fill="#9ed4b2"
          opacity="0.38"
        ></path>

        <!-- Tầng 2: Đồi chè & rừng cây xanh mát (chuyển động làn gió chậm) -->
        <g class="animate-rice-wave-slow">
          <path
            d="M0,228 Q340,145 710,218 T1440,168 L1440,460 L0,460 Z"
            fill="#66be82"
            opacity="0.48"
          ></path>
          <!-- Đường vân ruộng bậc thang xa -->
          <path
            d="M40,245 Q340,175 700,235 T1420,192"
            stroke="#dcfce7"
            stroke-width="2"
            stroke-opacity="0.45"
            fill="none"
          ></path>
        </g>

        <!-- Tầng 3: Cánh đồng lúa xanh đang thì con gái (chuyển động nhịp sóng lúa) -->
        <g class="animate-rice-wave-delayed">
          <path
            d="M0,285 C330,205 630,305 980,235 C1180,195 1340,255 1440,245 L1440,460 L0,460 Z"
            fill="#34b367"
            opacity="0.58"
          ></path>
          <!-- Đường bờ thửa ruộng lúa -->
          <path
            d="M0,305 C330,228 630,322 980,255 C1180,215 1340,270 1440,260"
            stroke="#bbf7d0"
            stroke-width="2.5"
            stroke-opacity="0.5"
            fill="none"
          ></path>
        </g>

        <!-- Tầng 4: Cánh đồng lúa chín vàng mùa gặt bội thu (Tone vàng lúa QTDND) -->
        <g class="animate-rice-wave-slow">
          <path
            d="M0,348 C380,275 720,385 1090,305 C1270,265 1375,325 1440,315 L1440,460 L0,460 Z"
            fill="#d4e66e"
            opacity="0.62"
          ></path>
          <path
            d="M0,375 C410,315 760,405 1120,335 C1290,300 1385,348 1440,340 L1440,460 L0,460 Z"
            fill="#eab308"
            opacity="0.22"
          ></path>
        </g>

        <!-- Tầng 5: Dòng kênh thủy lợi / Dòng vốn tín dụng xanh mát chảy qua thôn xóm -->
        <path
          d="M0,418 C310,368 425,438 685,388 C960,338 1200,428 1440,378 L1440,460 L0,460 Z"
          fill="#7dd3fc"
          opacity="0.65"
        ></path>
        <g class="animate-water-shimmer">
          <path
            d="M60,425 Q320,388 580,412 T1180,395"
            stroke="#ffffff"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-dasharray="18 14"
            stroke-opacity="0.65"
            fill="none"
          ></path>
        </g>

        <!-- Tầng 6: Cụm mái nhà ngói nông thôn mới & Điểm tựa hợp tác xã bên phải chân trời -->
        <g opacity="0.82">
          <!-- Thảm đồi nhỏ nơi đặt nhà văn hóa / hợp tác xã -->
          <path
            d="M1060,355 Q1240,318 1440,342 L1440,415 L1060,415 Z"
            fill="#15803d"
            opacity="0.35"
          ></path>
          <!-- Mái nhà ngói đỏ truyền thống Việt Nam -->
          <rect
            x="1225"
            y="312"
            width="76"
            height="36"
            rx="3"
            fill="#fef3c7"
            stroke="#d97706"
            stroke-width="1.5"
          />
          <polygon points="1215,314 1263,288 1311,314" fill="#dc2626" />
          <rect x="1254" y="324" width="18" height="24" rx="2" fill="#92400e" />
          <rect
            x="1234"
            y="322"
            width="12"
            height="12"
            rx="1.5"
            fill="#fde68a"
            stroke="#b45309"
            stroke-width="1"
          />
          <rect
            x="1280"
            y="322"
            width="12"
            height="12"
            rx="1.5"
            fill="#fde68a"
            stroke="#b45309"
            stroke-width="1"
          />
          <!-- Cây xanh bóng mát làng quê -->
          <circle cx="1198" cy="318" r="18" fill="#16a34a" />
          <circle cx="1210" cy="310" r="14" fill="#22c55e" />
          <rect x="1201" y="332" width="4" height="16" fill="#78350f" />
          <circle cx="1332" cy="322" r="15" fill="#15803d" />
          <rect x="1330" y="334" width="3.5" height="14" fill="#78350f" />
        </g>

        <!-- Tầng 7: Bông lúa vàng đung đưa nhẹ trong gió ở tiền cảnh (animate-rice-stalk-sway) -->
        <g
          class="animate-rice-stalk-sway"
          stroke="#ca8a04"
          stroke-width="2"
          fill="none"
          opacity="0.65"
        >
          <path d="M95,455 Q102,415 116,390" />
          <ellipse
            cx="114"
            cy="395"
            rx="4"
            ry="2"
            transform="rotate(-25 114 395)"
            fill="#facc15"
          />
          <ellipse
            cx="108"
            cy="406"
            rx="4"
            ry="2"
            transform="rotate(-25 108 406)"
            fill="#facc15"
          />
          <path d="M115,455 Q124,420 138,398" />
          <ellipse
            cx="135"
            cy="402"
            rx="4"
            ry="2"
            transform="rotate(-20 135 402)"
            fill="#eab308"
          />

          <path d="M980,455 Q988,412 1004,386" />
          <ellipse
            cx="1001"
            cy="390"
            rx="4.5"
            ry="2"
            transform="rotate(-25 1001 390)"
            fill="#facc15"
          />
          <ellipse
            cx="994"
            cy="402"
            rx="4.5"
            ry="2"
            transform="rotate(-25 994 402)"
            fill="#facc15"
          />
          <path d="M1002,455 Q1012,418 1026,395" />
          <ellipse
            cx="1023"
            cy="399"
            rx="4"
            ry="2"
            transform="rotate(-20 1023 399)"
            fill="#eab308"
          />
        </g>
      </svg>
    </div>

    <!-- Nội dung chính Hero tràn rộng, thoáng đãng và cân đối theo bố cục Vietcombank -->
    <Container class="relative z-10">
      <div
        data-page-content
        class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center py-6 sm:py-10 lg:py-14"
      >
        <!-- Cột trái (5 cột): Tinh gọn đúng chuẩn VCB (Tên Quỹ + Lời chào thời gian thực + Thanh tìm kiếm viên thuốc) -->
        <div class="lg:col-span-5 space-y-5">
          <h1 class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-brand-dark">
            {formatText(site.name)}
          </h1>

          <!-- Icon Mặt trời (Sáng/Chiều) & Mặt trăng (Tối) + Lời chào chuẩn phong cách Vietcombank -->
          <div data-dynamic-greeting class="flex items-center gap-3.5">
            <div
              data-greeting-icon-day
              class="relative w-14 h-14 sm:w-16 sm:h-16 shrink-0 select-none"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="w-full h-full"
              >
                <circle
                  cx="36"
                  cy="26"
                  r="19"
                  fill="#FDE047"
                  fill-opacity="0.35"
                />
                <g stroke="#F59E0B" stroke-width="2.5" stroke-linecap="round">
                  <line x1="36" y1="3" x2="36" y2="7" />
                  <line x1="52.3" y1="9.7" x2="49.4" y2="12.6" />
                  <line x1="59" y1="26" x2="55" y2="26" />
                  <line x1="52.3" y1="42.3" x2="49.4" y2="39.4" />
                  <line x1="19.7" y1="9.7" x2="22.6" y2="12.6" />
                </g>
                <circle cx="36" cy="26" r="13" fill="#FACC15" />
                <circle cx="34" cy="24" r="10" fill="#FDE047" />
                <path
                  d="M14 48H42C46.9706 48 51 43.9706 51 39C51 34.3429 47.4608 30.5123 42.9289 30.0471C41.3666 24.8195 36.5204 21 30.8 21C23.7308 21 18 26.7308 18 33.8C18 34.1297 18.0125 34.4565 18.0369 34.7799C14.6119 35.6054 12 38.6897 12 42.4C12 45.4928 14.5072 48 17.6 48H14Z"
                  fill="#FFFFFF"
                />
              </svg>
            </div>

            <div
              data-greeting-icon-night
              class="hidden relative w-14 h-14 sm:w-16 sm:h-16 shrink-0 select-none"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 64 64"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="w-full h-full"
              >
                <circle cx="18" cy="18" r="1.8" fill="#FBBF24" />
                <circle cx="52" cy="14" r="1.5" fill="#FDE047" />
                <path
                  d="M49 24L50.2 26.8L53 28L50.2 29.2L49 32L47.8 29.2L45 28L47.8 26.8L49 24Z"
                  fill="#FDE047"
                />
                <path
                  d="M41.5 12C34.2 13.6 28.8 20.1 28.8 27.9C28.8 36.9 36.1 44.2 45.1 44.2C48.7 44.2 52 43 54.7 41C51.6 46.5 45.7 50.2 38.9 50.2C28.9 50.2 20.8 42.1 20.8 32.1C20.8 22.6 28.1 14.8 37.4 14.1C38.8 12.9 40.1 12.3 41.5 12Z"
                  fill="#F59E0B"
                />
                <path
                  d="M12 50H36C40.4183 50 44 46.4183 44 42C44 37.8934 40.9067 34.5112 36.9189 34.0519C35.5122 29.6879 31.4161 26.5 26.5 26.5C20.4249 26.5 15.5 31.4249 15.5 37.5C15.5 37.8404 15.5155 38.1772 15.5458 38.5096C12.3999 39.2216 10 42.0329 10 45.4C10 47.9405 12.0595 50 14.6 50H12Z"
                  fill="#FFFFFF"
                />
              </svg>
            </div>

            <div class="space-y-0.5">
              <span
                class="block text-2xl sm:text-3xl font-extrabold text-ink-base tracking-tight"
                data-greeting-title
              >
                Chào buổi sáng
              </span>
              <p
                class="text-xs sm:text-sm text-ink-base font-medium"
                data-greeting-subtitle
              >
                Quý khách hàng đang tìm kiếm gì hôm nay?
              </p>
            </div>
          </div>

          <!-- Thanh tìm kiếm nhanh hình viên thuốc tinh gọn (Vietcombank Quick Search Pill) -->
          <div class="max-w-md">
            <div class="relative flex items-center rounded-full bg-white shadow-md border border-white/90 px-4 py-3 focus-within:ring-2 focus-within:ring-brand-primary transition-shadow">
              <span class="pr-3 text-ink-muted" aria-hidden="true">
                <svg
                  class="w-4 h-4 sm:w-5 sm:h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  ></path>
                </svg>
              </span>
              <input
                type="text"
                aria-label="Tìm kiếm sản phẩm, dịch vụ"
                placeholder="Tiền gửi tiết kiệm, vay vốn, lãi suất..."
                class="w-full bg-transparent text-xs sm:text-sm text-ink-base placeholder:text-ink-muted focus:outline-hidden font-medium"
              />
            </div>
          </div>
        </div>

        <!-- Cột phải (7 cột): Bố cục 3 cụm ngang tinh gọn chuẩn VCB (Hộp QR Zalo vuông + Thẻ đứng nghiêng nhẹ + Tiêu đề nghệ thuật trên nền trời) -->
        <div class="lg:col-span-7">
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-end gap-5 sm:gap-6 lg:gap-7">
            <!-- Cụm 1: Mã QR Zalo vuông trắng tinh gọn + Mũi tên cong kiểu VCB ("Quét để liên hệ") -->
            <div class="flex flex-col items-center shrink-0 sm:-mt-6">
              <div class="mb-1.5 flex flex-col items-center text-center">
                <span class="text-xs font-extrabold text-brand-dark tracking-tight italic">
                  Quét Zalo liên hệ
                </span>
                <svg
                  class="w-16 h-6 text-brand-primary"
                  viewBox="0 0 80 28"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M64 24 C54 6, 32 4, 16 14"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                  <path
                    d="M22 8 L15 15 L24 17"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </div>

              <a
                href={zaloHref}
                target="_blank"
                rel="noopener noreferrer"
                title="Quét mã QR Zalo hoặc bấm để liên hệ Quỹ tín dụng nhân dân"
                aria-label="Quét mã QR Zalo liên hệ Quỹ tín dụng nhân dân"
                class="animate-qr-float group relative w-32 h-32 sm:w-36 sm:h-36 rounded-2xl bg-white p-2.5 shadow-xl border-2 border-white hover:border-brand-primary transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-border-focus"
              >
                <div class="relative w-full h-full rounded-lg bg-white overflow-hidden">
                  <!-- Tia quét hoạt ảnh tinh tế -->
                  <div
                    class="animate-qr-scan absolute inset-x-1 top-1 h-1 rounded-full bg-gradient-to-r from-transparent via-[#00a85a] to-transparent pointer-events-none z-20"
                    aria-hidden="true"
                  ></div>

                  <!-- Mã QR Vector Mẫu sắc nét -->
                  <svg
                    viewBox="0 0 120 120"
                    class="w-full h-full text-slate-900"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <rect width="120" height="120" fill="#ffffff" />
                    <path d="M8,8 h28 v28 h-28 z M13,13 v18 h18 v-18 z M17,17 h10 v10 h-10 z" />
                    <path d="M84,8 h28 v28 h-28 z M89,13 v18 h18 v-18 z M93,17 h10 v10 h-10 z" />
                    <path d="M8,84 h28 v28 h-28 z M13,89 v18 h18 v-18 z M17,93 h10 v10 h-10 z" />
                    <rect x="42" y="8" width="6" height="6" />
                    <rect x="54" y="8" width="12" height="6" />
                    <rect x="72" y="8" width="6" height="6" />
                    <rect x="42" y="20" width="12" height="6" />
                    <rect x="60" y="20" width="6" height="12" />
                    <rect x="72" y="26" width="6" height="6" />
                    <rect x="42" y="32" width="6" height="6" />
                    <rect x="8" y="42" width="12" height="6" />
                    <rect x="26" y="42" width="6" height="12" />
                    <rect x="8" y="54" width="6" height="6" />
                    <rect x="18" y="60" width="12" height="6" />
                    <rect x="8" y="72" width="18" height="6" />
                    <rect x="84" y="42" width="6" height="12" />
                    <rect x="96" y="42" width="16" height="6" />
                    <rect x="90" y="56" width="12" height="6" />
                    <rect x="106" y="56" width="6" height="12" />
                    <rect x="84" y="68" width="16" height="6" />
                    <rect x="42" y="84" width="12" height="6" />
                    <rect x="60" y="84" width="6" height="12" />
                    <rect x="72" y="84" width="12" height="6" />
                    <rect x="90" y="84" width="12" height="12" />
                    <rect x="106" y="84" width="6" height="6" />
                    <rect x="42" y="96" width="6" height="16" />
                    <rect x="54" y="102" width="18" height="10" />
                    <rect x="78" y="96" width="12" height="6" />
                    <rect x="84" y="106" width="28" height="6" />
                    <!-- Tâm QR: Biểu tượng Zalo -->
                    <rect
                      x="44"
                      y="44"
                      width="32"
                      height="32"
                      rx="7"
                      fill="#0068ff"
                      stroke="#ffffff"
                      stroke-width="3"
                    />
                    <text
                      x="60"
                      y="64"
                      text-anchor="middle"
                      fill="#ffffff"
                      font-size="11"
                      font-weight="800"
                      font-family="sans-serif"
                    >
                      Zalo
                    </text>
                  </svg>
                </div>
              </a>
            </div>

            <!-- Cụm 2: Thẻ đứng Sổ Tiết Kiệm nghiêng nhẹ & lắc định kỳ (giống thẻ đứng giữa của VCB) -->
            <div class="w-48 sm:w-52 shrink-0 rounded-2xl bg-[#014d27] bg-gradient-to-b from-[#006d35] via-[#015a30] to-[#014d27] p-4 sm:p-5 text-white shadow-2xl border-2 border-white/40 animate-card-periodic-sway flex flex-col justify-between min-h-[240px] sm:min-h-[260px]">
              <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold tracking-wider uppercase text-white">
                  QTDND
                </span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-black/30 text-[#ffd100]">
                  DIV Bảo chứng
                </span>
              </div>

              <!-- Chip thẻ & Họa tiết bông lúa vàng -->
              <div class="my-3 space-y-2">
                <div class="w-9 h-7 rounded-md bg-amber-300/90 border border-amber-200/80 flex items-center justify-center">
                  <div class="w-5 h-4 border border-amber-700/40 rounded-xs"></div>
                </div>
                <div class="pt-1">
                  <div class="text-[11px] text-white/90 font-medium">
                    Tiết kiệm lãi suất đến
                  </div>
                  <div class="text-2xl sm:text-3xl font-extrabold text-[#ffd100] leading-none mt-0.5">
                    {maxDepositRate > 0
                      ? `${maxDepositRate.toString().replace('.', ',')}%`
                      : DEFAULT_FALLBACK_TEXT}
                    {maxDepositRate > 0 && (
                      <span class="text-xs font-semibold text-white">/năm</span>
                    )}
                  </div>
                </div>
              </div>

              <div class="border-t border-white/25 pt-2.5 flex items-center justify-between text-[11px]">
