---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import RatesTables from '../components/RatesTables.astro';
import { getSite, getRates, getContact, getSchedule } from '../lib/data';
import {
  getPublishedNews,
  getNewsDetailHref,
  getNewsCategoryLabel,
} from '../lib/news';
import {
  formatAsOf,
  formatDate,
  formatDateIso,
  formatNumber,
} from '../lib/format';
import { DEFAULT_FALLBACK_TEXT } from '../lib/constants';

const site = await getSite();
const rates = await getRates();
const contact = await getContact();
const schedule = await getSchedule();
const publishedNews = await getPublishedNews();

const siteTitle = `Giao diện phong cách VCB tràn viền & Tone màu QTDND — Quỹ tín dụng nhân dân ${site.name}`;
const siteDescription = `Bản thử nghiệm giao diện phong cách Vietcombank với trang nền phong cảnh tràn viền, tông màu xanh QTDND truyền thống và thanh dock tiện ích hiện đại.`;

// Lấy lãi suất cao nhất trong kỳ hạn tiền gửi để hiển thị trên thanh tiện ích
const maxDepositRate = rates.deposit_rates.reduce((max: number, item) => {
  if (item.rate !== null && item.rate > max) {
    return item.rate;
  }
  return max;
}, 0);
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <!-- 0. Banner thông báo chế độ xem thử nghiệm POC -->
  <div class="bg-gradient-to-r from-[#008a49] via-[#00a85a] to-[#015a30] text-white text-xs sm:text-sm py-2 px-4 shadow-xs border-b border-white/20">
    <div class="w-full max-w-[1536px] mx-auto px-2 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-[#ffd100] text-emerald-950 font-extrabold text-[11px] tracking-wider uppercase shadow-2xs">
          POC v2 &bull; Tràn viền
        </span>
        <span>
          Giao diện <strong>phong cảnh tràn viền phong cách Vietcombank</strong>{' '}
          &bull; Tông màu xanh <strong>logo QTDND truyền thống</strong>.
        </span>
      </div>
      <a
        href="/"
        class="inline-flex items-center gap-1 font-bold text-emerald-100 hover:text-white underline underline-offset-2 shrink-0 text-xs sm:text-sm focus-visible:outline-2 focus-visible:outline-white rounded"
      >
        &larr; Quay lại trang chủ hiện tại
      </a>
    </div>
  </div>

  <!-- 1. Thanh phân khúc khách hàng đỉnh trang kiểu Vietcombank (Customer Segment Bar) -->
  <div class="bg-white/80 backdrop-blur-md border-b border-emerald-900/10 text-xs sm:text-sm hidden md:block">
    <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12 flex items-center justify-between py-2">
      <div class="flex items-center space-x-1.5 text-ink-muted">
        <span class="font-bold text-brand-primary bg-emerald-50 px-3.5 py-1 rounded-full border border-emerald-200 shadow-2xs">
          Thành viên &amp; Cá nhân
        </span>
        <a
          href="#san-pham"
          class="px-3 py-1 rounded-full hover:text-brand-primary hover:bg-emerald-50/60 transition-colors"
        >
          Hộ sản xuất nông nghiệp
        </a>
        <a
          href="#san-pham"
          class="px-3 py-1 rounded-full hover:text-brand-primary hover:bg-emerald-50/60 transition-colors"
        >
          Hộ kinh doanh &amp; Hợp tác xã
        </a>
        <a
          href="#co-opbank"
          class="px-3 py-1 rounded-full hover:text-brand-primary hover:bg-emerald-50/60 transition-colors"
        >
          Ngân hàng số Co-opBank
        </a>
        <a
          href="/gioi-thieu"
          class="px-3 py-1 rounded-full hover:text-brand-primary hover:bg-emerald-50/60 transition-colors"
        >
          Về QTDND Vạn Trạch
        </a>
      </div>
      <div class="flex items-center gap-4 text-xs text-ink-muted font-medium">
        <span>
          Hotline:{' '}
          <strong class="text-brand-primary font-bold">
            {contact.phone || '0232 3848 123'}
          </strong>
        </span>
        <span class="text-border-default">|</span>
        <span>
          Giờ phục vụ: {schedule.morning_hours} &amp; {schedule.afternoon_hours}
        </span>
      </div>
    </div>
  </div>

  <!-- 2. Hero Section: Trang nền phong cảnh nông thôn & đồng lúa trải dài tràn viền (VCB Scenic Landscape Background) -->
  <section class="relative w-full overflow-hidden bg-gradient-to-b from-[#d9f2e6] via-[#e8f7ee] to-[#f4faf6] pt-8 pb-28 sm:pt-12 sm:pb-32 lg:pt-16 lg:pb-40">
    <!-- SVG Vector Phong Cảnh Tràn Viền (Bầu trời, đồi núi, ruộng bậc thang lúa vàng, dòng suối uốn lượn) -->
    <div
      class="absolute inset-0 w-full h-full pointer-events-none select-none overflow-hidden"
      aria-hidden="true"
    >
      <!-- Ánh mặt trời dịu êm góc phải -->
      <div class="absolute top-6 right-12 sm:right-28 w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-[#fde047] opacity-60 blur-xl"></div>
      <div class="absolute top-10 right-16 sm:right-32 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#fef08a] border-2 border-white/60 shadow-lg shadow-amber-300/40"></div>

      <!-- Đám mây trôi mềm mại -->
      <svg
        class="absolute top-12 left-10 w-48 h-16 opacity-40 text-white"
        fill="currentColor"
        viewBox="0 0 100 35"
      >
        <path d="M10 25 a15 15 0 0 1 25 -10 a20 20 0 0 1 35 0 a15 15 0 0 1 25 10 z"></path>
      </svg>
      <svg
        class="hidden sm:block absolute top-20 right-1/3 w-64 h-20 opacity-30 text-white"
        fill="currentColor"
        viewBox="0 0 100 35"
      >
        <path d="M10 25 a15 15 0 0 1 25 -10 a20 20 0 0 1 35 0 a15 15 0 0 1 25 10 z"></path>
      </svg>

      <!-- Các dãy đồi xanh & ruộng lúa tầng tầng lớp lớp bao quát toàn cảnh -->
      <svg
        class="absolute bottom-0 inset-x-0 w-full h-[65%] sm:h-[72%] object-cover"
        preserveAspectRatio="none"
        viewBox="0 0 1440 450"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Dãy núi mờ phía xa -->
        <path
          d="M0,180 Q360,90 720,160 T1440,110 L1440,450 L0,450 Z"
          fill="#a7d8b5"
          opacity="0.35"
        ></path>

        <!-- Đồi xanh tầng trung -->
        <path
          d="M0,230 Q320,150 680,220 T1440,170 L1440,450 L0,450 Z"
          fill="#6cc287"
          opacity="0.45"
        ></path>

        <!-- Ruộng bậc thang lúa xanh trù phú (Tone xanh QTDND) -->
        <path
          d="M0,290 C340,210 620,310 980,240 C1180,200 1340,260 1440,250 L1440,450 L0,450 Z"
          fill="#3db86e"
          opacity="0.55"
        ></path>

        <!-- Đồi ruộng lúa vàng chín rộ (Tone vàng lúa QTDND) -->
        <path
          d="M0,350 C380,280 720,390 1100,310 C1280,270 1380,330 1440,320 L1440,450 L0,450 Z"
          fill="#d8e878"
          opacity="0.5"
        ></path>

        <!-- Dòng sông / suối xanh mát uốn lượn tượng trưng cho sự trù phú và dòng vốn lưu thông -->
        <path
          d="M0,420 C320,370 420,440 680,390 C960,340 1200,430 1440,380 L1440,450 L0,450 Z"
          fill="#7dd3fc"
          opacity="0.6"
        ></path>
        <path
          d="M0,435 C340,395 440,450 700,410 C980,370 1220,445 1440,405 L1440,450 L0,450 Z"
          fill="#38bdf8"
          opacity="0.5"
        ></path>

        <!-- Thảm cỏ xanh mặt tiền -->
        <path
          d="M0,410 Q480,360 960,400 T1440,390 L1440,450 L0,450 Z"
          fill="#1fad5c"
          opacity="0.25"
        ></path>
      </svg>
    </div>

    <!-- Nội dung chính Hero tràn rộng (Widescreen Full-Width) -->
    <div class="relative z-10 w-full max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Cột trái: Lời chào thời gian thực, Tìm kiếm & Thông điệp thân thiện -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Logo QTDND cổ điển & Lời chào thân thiện kiểu Vietcombank -->
          <div class="flex items-center gap-3.5">
            <img
              src="/images/logo-qtdnd-classic.png"
              alt="Logo truyền thống Quỹ tín dụng nhân dân"
              width="68"
              height="68"
              class="h-16 sm:h-20 w-auto object-contain drop-shadow-md shrink-0"
            />
            <div data-dynamic-greeting class="space-y-0.5">
              <div class="flex items-center gap-2">
                <span
                  class="text-xl sm:text-2xl font-extrabold text-brand-primary"
                  data-greeting-title
                >
                  Chào buổi chiều
                </span>
                <span class="text-lg animate-bounce" aria-hidden="true">
                  👋
                </span>
              </div>
              <p
                class="text-xs sm:text-sm text-ink-muted font-medium"
                data-greeting-subtitle
              >
                Hôm nay Quỹ có thể đồng hành gì cùng bà con và thành viên?
              </p>
            </div>
          </div>

          <!-- Tiêu đề lớn nhận diện thương hiệu Quỹ Vạn Trạch -->
          <div class="space-y-2">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
              <span class="block text-brand-primary uppercase font-bold text-base sm:text-xl tracking-wider">
                Quỹ Tín Dụng Nhân Dân
              </span>
              <span class="block text-ink-base text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mt-1">
                VẠN TRẠCH
              </span>
            </h1>
            <p class="text-sm sm:text-base lg:text-lg text-ink-base/80 leading-relaxed max-w-2xl font-normal pt-1">
              Điểm tựa tài chính hợp tác xã vững chắc từ năm 1958. Tương trợ vốn
              phát triển nông nghiệp, chăn nuôi, kinh doanh và bảo vệ quyền lợi
              trọn vẹn cho mọi thành viên địa phương.
            </p>
          </div>

          <!-- Thanh tìm kiếm nhanh hình viên thuốc (Vietcombank Quick Search Pill) -->
          <div class="max-w-xl">
            <div class="relative flex items-center rounded-full bg-white/95 backdrop-blur-md shadow-lg border border-emerald-300/70 p-1.5 focus-within:ring-2 focus-within:ring-brand-primary transition-all">
              <span class="pl-3.5 pr-2 text-brand-primary">
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                  ></path>
                </svg>
              </span>
              <input
                type="text"
                aria-label="Tìm kiếm sản phẩm, dịch vụ"
                placeholder="Bạn muốn tìm: Lãi suất tiết kiệm, vay mua trâu bò, thẻ Co-opBank..."
                class="w-full bg-transparent text-xs sm:text-sm text-ink-base placeholder:text-ink-muted focus:outline-hidden py-1.5 font-medium"
              />
              <a
                href="#lai-suat"
                class="inline-flex items-center px-4 py-2 rounded-full bg-brand-primary hover:bg-[#008a49] text-white text-xs sm:text-sm font-bold transition-colors shrink-0 shadow-xs"
              >
                Tra cứu
              </a>
            </div>
            <!-- Từ khóa gợi ý nhanh -->
            <div class="flex flex-wrap items-center gap-2 mt-2.5 px-3 text-xs text-ink-subtle">
              <span class="font-semibold text-emerald-800">Gợi ý nhanh:</span>
              <a
                href="#lai-suat"
                class="hover:text-brand-primary underline underline-offset-2"
              >
                Lãi suất gửi 12 tháng
              </a>
              <span class="text-border-strong">&bull;</span>
              <a
                href="#tinh-lai"
                class="hover:text-brand-primary underline underline-offset-2"
              >
                Tính tiền lãi tiết kiệm
              </a>
              <span class="text-border-strong">&bull;</span>
              <a
                href="#san-pham"
                class="hover:text-brand-primary underline underline-offset-2"
              >
                Vay mùa vụ nông nghiệp
              </a>
            </div>
          </div>
        </div>

        <!-- Cột phải: Bộ thẻ tài chính & Sổ tiết kiệm xếp lớp sinh động (Vietcombank Floating Card Stack) -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-md">
            <!-- Thẻ 1: Sổ tiết kiệm thành viên uy tín -->
            <div class="relative z-10 rounded-3xl bg-gradient-to-br from-[#008a49] via-[#00a85a] to-[#015a30] p-6 text-white shadow-2xl border-2 border-white/40 transform sm:-rotate-2 hover:rotate-0 transition-transform duration-300">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ffd100]"></span>
                  <span class="text-xs uppercase font-extrabold tracking-wider text-emerald-100">
                    Sổ Tiết Kiệm Thành Viên
                  </span>
                </div>
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-white/20 backdrop-blur-xs">
                  Bảo hiểm DIV 100%
                </span>
              </div>

              <div class="my-6 space-y-1">
                <div class="text-xs text-emerald-100 font-medium">
                  Lãi suất cao nhất áp dụng:
                </div>
                <div class="text-3xl sm:text-4xl font-extrabold text-white flex items-baseline gap-1">
                  {maxDepositRate.toString().replace('.', ',')}%
                  <span class="text-sm font-semibold text-emerald-200">
                    /năm
                  </span>
                </div>
                <div class="text-xs text-emerald-200 pt-1">
                  Kỳ hạn linh hoạt từ 01 đến 36 tháng &bull; Rút gốc linh hoạt
                </div>
              </div>

              <div class="flex items-center justify-between text-xs border-t border-white/20 pt-3">
                <span class="font-semibold text-white/90">QTDND Vạn Trạch</span>
                <span class="text-emerald-100">GP: 04NH-GP</span>
              </div>
            </div>

            <!-- Thẻ 2: Thẻ Chip Co-opBank Napas lấp ló phía sau -->
            <div class="absolute -top-4 -right-2 sm:-top-6 sm:-right-4 w-4/5 rounded-3xl bg-gradient-to-r from-teal-700 to-cyan-800 p-5 text-white shadow-xl transform rotate-6 border border-white/30 -z-0 opacity-85">
              <div class="flex justify-between items-center text-[10px] font-bold text-teal-200">
                <span>Co-opBank NAPAS</span>
                <span>Thẻ chip chuẩn EMV</span>
              </div>
              <div class="h-14"></div>
            </div>

            <!-- Huy hiệu BHTG DIV nổi bật đè góc -->
            <div class="absolute -bottom-6 -left-4 sm:-bottom-8 sm:-left-6 z-20 bg-white/95 backdrop-blur-md rounded-2xl p-3 shadow-xl border border-emerald-200 flex items-center gap-3">
              <img
                src="/images/chung-nhan-bhtg-vn.png"
                alt="Chứng nhận Bảo hiểm tiền gửi Việt Nam"
                width="70"
                height="48"
                class="h-10 sm:h-12 w-auto object-contain"
              />
              <div class="text-left">
                <div class="text-[11px] font-bold text-ink-base leading-tight">
                  Bảo Hiểm Tiền Gửi VN
                </div>
                <div class="text-[10px] text-brand-primary font-semibold">
                  Tổ chức đã tham gia BHTG
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Thanh Tiện Ích Dock Nổi Hình Viên Thuốc (Vietcombank Floating Pill Dock) -->
  <section class="relative z-30 -mt-12 sm:-mt-14 lg:-mt-16">
    <div class="w-full max-w-[1536px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="rounded-3xl sm:rounded-full bg-white/95 backdrop-blur-xl shadow-2xl border border-emerald-200/80 p-3 sm:p-4 lg:py-4 lg:px-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 sm:gap-3 items-center">
          <!-- 1. Gợi ý sản phẩm -->
          <a
            href="#san-pham"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-brand-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                ></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary">
                Gói Nông Nghiệp
              </div>
              <div class="text-[11px] text-ink-muted hidden sm:block">
                Ưu đãi mùa vụ
              </div>
            </div>
          </a>

          <!-- 2. Biểu lãi suất -->
          <a
            href="#lai-suat"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-brand-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                ></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary">
                Biểu Lãi Suất
              </div>
              <div class="text-[11px] text-brand-primary font-bold">
                Đến {maxDepositRate}%/năm
              </div>
            </div>
          </a>

          <!-- 3. Ước tính tiền gửi -->
          <a
            href="#tinh-lai"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-brand-primary flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                ></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary">
                Tính Tiền Gửi
              </div>
              <div class="text-[11px] text-ink-muted hidden sm:block">
                Mô phỏng tiền lãi
              </div>
            </div>
          </a>

          <!-- 4. Vay vốn thành viên -->
          <a
            href="#san-pham"
            class="flex items-center gap-3 p-2.5 sm:px-4 sm:py-2.5 rounded-full hover:bg-emerald-50 transition-colors group"
          >
            <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                ></path>
              </svg>
            </div>
            <div class="text-left">
              <div class="text-xs sm:text-sm font-bold text-ink-base group-hover:text-brand-primary">
                Vay Thành Viên
              </div>
              <div class="text-[11px] text-ink-muted hidden sm:block">
                Từ 7,5%/năm
              </div>
            </div>
          </a>

          <!-- 5. Dịch vụ Co-opBank -->
          <a
