---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite, getContact, getSchedule } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}

const site = await getSite();
const contact = await getContact();
const schedule = await getSchedule();

const defaultTitle = site.name
  ? `Quỹ tín dụng nhân dân ${site.name}`
  : 'Quỹ tín dụng nhân dân';

const {
  title = defaultTitle,
  description = `Cổng thông tin Quỹ tín dụng nhân dân ${site.name}`,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://qtd.workers.dev'
);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
  </head>
  <body class="min-h-screen flex flex-col bg-surface-page text-ink-base">
    <SkipLink targetId="main-content" />

    <Header siteName={site.name} />

    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>

    <Footer site={site} contact={contact} schedule={schedule} />
  </body>
</html>
