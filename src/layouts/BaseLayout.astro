---
import '../styles/global.css';
import fontVn400 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-400-normal.woff2?url';
import fontLatin400 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import fontVn600 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-600-normal.woff2?url';
import fontLatin600 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-600-normal.woff2?url';
import fontVn700 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-700-normal.woff2?url';
import fontLatin700 from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-700-normal.woff2?url';
import SkipLink from '../components/SkipLink.astro';
import TopAnnouncementBar from '../components/TopAnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getSite, getContact, getSchedule } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string | null;
  noindex?: boolean;
}

const site = await getSite();
const contact = await getContact();
const schedule = await getSchedule();

const {
  title,
  description,
  canonical,
  type = 'website',
  publishedTime = null,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontVn400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontLatin400}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontVn600}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontLatin600}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontVn700}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={fontLatin700}
      crossorigin
    />
    <link rel="icon" type="image/png" href="/images/logo.png?v=20261023" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261023" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261023" />
    <link rel="apple-touch-icon" href="/images/logo.png?v=20261023" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      type={type}
      publishedTime={publishedTime}
      noindex={noindex}
      site={site}
      contact={contact}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-surface-page text-ink-base">
    <SkipLink targetId="main-content" />

    <TopAnnouncementBar />

    <Header siteName={site.name} contact={contact} schedule={schedule} />

    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>

    <Footer site={site} contact={contact} schedule={schedule} />
  </body>
</html>
